{% extends 'base.twig' %}
{% block content %}
<div class="container admin-dashboard-page">
  <div class="admin-page-head">
    <div>
      <div class="eyebrow">ADMIN MANAGEMENT</div>
      <h1>Admin Dashboard</h1>
      <p class="muted">Manage open and active Ekubs. Full groups are in the Full Ekubs list.</p>
    </div>
    <a class="btn" href="{{url_for('admin_full_ekubs')}}">Full Ekubs <span class="dd-badge">{{full_count}}</span></a>
  </div>

  <div class="admin-stats-grid">
    <div class="card"><div class="stat">{{stats.collected}} ETB</div><span>Total Collected</span></div>
    <div class="card"><div class="stat">{{stats.members}}</div><span>Members</span></div>
    <div class="card"><div class="stat">{{stats.ekubs}}</div><span>Ekubs</span></div>
    <div class="card"><div class="stat">{{stats.profit}} ETB</div><span>Profit</span></div>
    <div class="card"><div class="stat">{{pending}}</div><span>Pending Payments</span></div>
    <div class="card"><div class="stat">{{kycs}}</div><span>Pending KYC</span></div>
  </div>

  <section class="admin-ekub-section">
    <div class="section-title-row">
      <div>
        <h2>Open &amp; Active Ekubs</h2>
        <p class="muted">Ekubs that are still accepting members or have remaining capacity.</p>
      </div>
      <div class="ekub-filter" role="group" aria-label="Filter Ekubs by category">
        <button class="category-filter active" data-category="all" type="button" aria-pressed="true">All</button>
        {% set categories = ekubs|map(attribute: 'category')|list|unique|list %}
        {% for category in categories %}
          <button class="category-filter" data-category="{{category|e}}" type="button" aria-pressed="false">{{category}}</button>
        {% endfor %}
      </div>
    </div>

    <div class="admin-ekub-groups">
      
      {% for category, category_ekubs in ekubs|groupby('category') %}
      <section class="admin-category-group" data-category-group="{{ category|e }}">
        <div class="category-heading"><div class="category-icon">{{ category[:1]|upper }}</div><div><h3>{{ category }}</h3><span>{{ category_ekubs|length }} Ekub{% if category_ekubs|length != 1 %}s{% endif %}</span></div></div>
        <div class="admin-ekub-grid">
          {% for e in category_ekubs %}
          <article class="admin-ekub-card">
            <div class="ekub-card-top"><span class="category-badge">{{ e.category }}</span><div class="ekub-card-controls"><span class="status-badge status-{{ e.status|lower }}">{{ e.status|capitalize }}</span><details class="ekub-menu"><summary aria-label="Ekub actions" title="Ekub actions">⋮</summary><div class="ekub-menu-popover">{% if e.status == 'open' and e.joined_count == 0 %}<a href="{{url_for('admin_edit_ekub', ekub_id: e.id)}}">Edit</a><form method="post" action="{{url_for('admin_delete_ekub', ekub_id: e.id)}}" onsubmit="return confirm('Delete this Ekub? This cannot be undone.');">{{csrf_field()}}<button type="submit" class="ekub-delete-action">Delete</button></form>{% else %}<span class="ekub-menu-disabled" title="Only open Ekubs with no members, payments, or payouts can be changed.">Edit</span><span class="ekub-menu-disabled" title="Only open Ekubs with no members, payments, or payouts can be deleted.">Delete</span>{% endif %}</div></details></div></div>
            <h4>{{ e.name }}</h4>
            <div class="ekub-card-meta"><div><small>Payment</small><strong>{{ e.frequency }}</strong></div><div><small>Amount</small><strong>{{ e.base_amount }} ETB</strong></div><div><small>Duration</small><strong>{{ e.duration }} periods</strong></div><div><small>Joined</small><strong>{{ e.joined_count }}</strong></div><div><small>Slots left</small><strong>{% if e.is_full %}<span style="color:#16803c">Full</span>{% else %}{{ e.left_slots }}{% endif %}</strong></div></div>
            <div class="ekub-actions ekub-info-actions"><a class="btn ghost" href="{{ url_for('admin_ekub_information', ekub_id=e.id) }}">Information</a><a class="btn ghost" href="{{ url_for('ekub_detail', ekub_id=e.id) }}">Details</a></div>
            {% if e.status == 'open' %}<form method="post" action="{{ url_for('start_ekub', ekub_id=e.id) }}" class="ekub-actions">{{ csrf_field() }}<button class="btn" type="submit">Start Ekub</button></form>{% elseif e.status == 'started' %}<div class="ekub-actions"><a class="btn ghost" href="{{ url_for('admin_payments', ekub_id=e.id, period_no=e.current_period) }}">Payments · {{e.ready_members}}/{{e.joined_count}} paid</a>{% if e.can_pick_winner %}<a class="btn" href="{{ url_for('pick_winner', ekub_id=e.id, period_no=e.current_period) }}">Pick Winner</a>{% else %}<span class="btn ghost" aria-disabled="true" title="Every member must finish paying this period before a winner can be picked.">Pick Winner · Waiting</span>{% endif %}</div>{% endif %}
          </article>
          {% endfor %}
        </div>
      </section>
      {% endfor %}
      {% if not ekubs %}
      <div class="empty-state card">
        <h3>No Ekubs created yet</h3>
        <p>Create an Ekub from the admin navigation to see it listed here.</p>
      </div>
      {% endif %}
    </div>
  </section>
</div>

<style>
.admin-page-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:22px}
.eyebrow{font-size:.72rem;font-weight:800;letter-spacing:.12em;opacity:.65;margin-bottom:5px}
.muted{opacity:.68;margin:.25rem 0 0}
.section-title-row{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;margin:30px 0 18px}
.section-title-row h2{margin:0}
.ekub-filter{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end}
.category-filter{border:1px solid rgba(127,127,127,.22);background:transparent;border-radius:999px;padding:9px 15px;font-weight:700;cursor:pointer;color:inherit;transition:.2s}
.category-filter:hover,.category-filter.active{background:var(--primary,#2563eb);color:#fff;border-color:var(--primary,#2563eb)}
.admin-category-group{margin-bottom:30px}
.category-heading{display:flex;align-items:center;gap:12px;margin-bottom:14px;padding:12px 14px;border-radius:16px;background:rgba(127,127,127,.07);border:1px solid rgba(127,127,127,.12)}
.category-heading h3{margin:0;font-size:1.05rem}.category-heading span{font-size:.8rem;opacity:.62}
.category-icon{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:var(--primary,#2563eb);color:#fff;font-weight:900}
.admin-ekub-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.admin-ekub-card{padding:17px;border:1px solid rgba(127,127,127,.16);border-radius:18px;background:var(--card-bg,#fff);box-shadow:0 8px 24px rgba(0,0,0,.06);transition:transform .2s,box-shadow .2s}
.admin-ekub-card:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(0,0,0,.1)}
.ekub-card-top{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:12px}
.ekub-card-controls{display:flex;align-items:center;gap:7px}.ekub-menu{position:relative;z-index:2}.ekub-menu summary{display:grid;place-items:center;width:31px;height:31px;border:1px solid rgba(127,127,127,.22);border-radius:10px;list-style:none;font-size:21px;line-height:1;cursor:pointer;user-select:none}.ekub-menu summary::-webkit-details-marker{display:none}.ekub-menu[open] summary{background:rgba(127,127,127,.1)}.ekub-menu-popover{position:absolute;right:0;top:36px;min-width:145px;padding:6px;border:1px solid rgba(127,127,127,.2);border-radius:12px;background:var(--card-bg,#fff);box-shadow:0 12px 30px rgba(0,0,0,.18);display:grid;gap:2px}.ekub-menu-popover a,.ekub-menu-popover button,.ekub-menu-disabled{display:block;width:100%;padding:9px 10px;border:0;border-radius:8px;background:transparent;color:inherit;text-align:left;text-decoration:none;font:inherit;font-size:.86rem;cursor:pointer}.ekub-menu-popover a:hover{background:rgba(37,99,235,.1)}.ekub-menu-popover form{margin:0}.ekub-menu-popover .ekub-delete-action{color:#dc2626}.ekub-menu-popover .ekub-delete-action:hover{background:rgba(220,38,38,.09)}.ekub-menu-disabled{opacity:.45;cursor:not-allowed}
.category-badge,.status-badge{font-size:.7rem;font-weight:800;border-radius:999px;padding:5px 9px}.category-badge{background:rgba(37,99,235,.1);color:var(--primary,#2563eb)}
.status-badge{background:rgba(127,127,127,.12)}.status-open{background:rgba(34,197,94,.12);color:#16803c}.status-started{background:rgba(245,158,11,.14);color:#a15c00}
.admin-ekub-card h4{margin:0 0 14px;font-size:1.05rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ekub-card-meta{display:grid;grid-template-columns:1fr;gap:8px;margin-bottom:14px}.ekub-card-meta div{display:flex;justify-content:space-between;gap:10px}.ekub-card-meta small{opacity:.58}.ekub-card-meta strong{font-size:.84rem;text-align:right}
.ekub-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.ekub-info-actions{margin-bottom:8px}.ekub-actions .btn{flex:1;text-align:center}.ekub-actions form{flex:1}.ekub-actions form .btn{width:100%}
.empty-state{text-align:center;padding:42px 20px}.empty-state h3{margin-bottom:5px}
@media(max-width:1100px){.admin-ekub-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:800px){.section-title-row{align-items:flex-start;flex-direction:column}.ekub-filter{justify-content:flex-start}.admin-ekub-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.admin-ekub-grid{grid-template-columns:1fr}.admin-ekub-card{padding:15px}}

/* Compact, polished cards for Ekubs created by the admin. */
.admin-dashboard-page .admin-ekub-grid{grid-template-columns:repeat(5,minmax(0,1fr))!important;gap:12px!important;align-items:stretch}
.admin-dashboard-page .admin-stats-grid{grid-template-columns:repeat(6,minmax(0,1fr));grid-template-rows:none;gap:12px;margin:18px 0 26px}
.admin-dashboard-page .admin-stats-grid .card{min-width:0;min-height:82px;padding:11px 12px;border:1px solid var(--border);border-radius:14px;background:linear-gradient(145deg,var(--surface),var(--surface-2));box-shadow:0 5px 15px rgba(0,0,0,.06);gap:5px}
.admin-dashboard-page .admin-stats-grid .stat{font-size:clamp(1rem,1.5vw,1.3rem);line-height:1.1;overflow-wrap:anywhere}
.admin-dashboard-page .admin-stats-grid .card>span{font-size:.72rem;line-height:1.2}
.admin-dashboard-page .admin-ekub-card{display:flex;flex-direction:column;min-width:0;max-width:none!important;padding:12px!important;border:1px solid var(--border);border-radius:16px!important;background:linear-gradient(145deg,var(--surface),color-mix(in srgb,var(--surface) 91%,var(--green-light)));box-shadow:0 7px 20px rgba(0,0,0,.07);transition:transform .2s ease,box-shadow .2s ease}
.admin-dashboard-page .admin-ekub-card:hover{transform:translateY(-2px);box-shadow:0 12px 26px rgba(0,0,0,.12)}
.admin-dashboard-page .admin-ekub-card.menu-open{position:relative;z-index:30}
.admin-dashboard-page .ekub-menu-popover{z-index:5}
.admin-dashboard-page .admin-ekub-card .ekub-card-top{min-height:0!important;margin:0 0 9px!important;padding:6px!important;border:1px solid var(--border);border-radius:11px;background:var(--surface-2);}
.admin-dashboard-page .admin-ekub-card .category-badge{background:var(--green-light);color:var(--accent-ink);font-size:.65rem!important;padding:4px 8px!important}
.admin-dashboard-page .admin-ekub-card h4{margin:0 0 10px!important;font-size:1rem!important;line-height:1.25;overflow-wrap:anywhere}
.admin-dashboard-page .admin-ekub-card .ekub-card-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px!important;margin:0 0 10px!important}
.admin-dashboard-page .admin-ekub-card .ekub-card-meta>div{display:flex;flex-direction:column;align-items:flex-start;gap:3px;min-width:0;padding:7px 8px;border:1px solid var(--border);border-radius:10px;background:var(--surface-2)}
.admin-dashboard-page .admin-ekub-card .ekub-card-meta>div:last-child:nth-child(odd){grid-column:1/-1}
.admin-dashboard-page .admin-ekub-card .ekub-card-meta small{font-size:.62rem!important;font-weight:800;letter-spacing:.035em;text-transform:uppercase;color:var(--muted)}
.admin-dashboard-page .admin-ekub-card .ekub-card-meta strong{font-size:.76rem!important;text-align:left;color:var(--text);overflow-wrap:anywhere}
.admin-dashboard-page .admin-ekub-card .ekub-actions{gap:6px!important}
.admin-dashboard-page .admin-ekub-card .ekub-info-actions{margin-bottom:6px!important}
.admin-dashboard-page .admin-ekub-card .ekub-actions .btn{min-height:32px!important;padding:7px 8px!important;border-radius:9px;font-size:.72rem!important}
@media(max-width:1250px){.admin-dashboard-page .admin-ekub-grid{grid-template-columns:repeat(4,minmax(0,1fr))!important}}
@media(max-width:1000px){.admin-dashboard-page .admin-stats-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:1000px){.admin-dashboard-page .admin-ekub-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important}}
@media(max-width:740px){.admin-dashboard-page .admin-stats-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.admin-dashboard-page .admin-ekub-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:9px!important}}
@media(max-width:600px){.admin-dashboard-page .admin-stats-grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:none;gap:8px;margin:14px 0 20px}.admin-dashboard-page .admin-stats-grid .card{min-height:72px;padding:10px;gap:5px}.admin-dashboard-page .admin-stats-grid .stat{font-size:1.1rem}.admin-dashboard-page .admin-stats-grid .card>span{font-size:.72rem}.admin-dashboard-page .admin-ekub-card{padding:8px!important}.admin-dashboard-page .admin-ekub-card .ekub-card-top{padding:4px!important;margin-bottom:7px!important}.admin-dashboard-page .admin-ekub-card h4{font-size:.9rem!important;margin-bottom:7px!important}.admin-dashboard-page .admin-ekub-card .ekub-card-meta{gap:5px!important;margin-bottom:8px!important}.admin-dashboard-page .admin-ekub-card .ekub-card-meta>div{padding:5px}.admin-dashboard-page .admin-ekub-card .ekub-card-meta small{font-size:.55rem!important}.admin-dashboard-page .admin-ekub-card .ekub-card-meta strong{font-size:.66rem!important}.admin-dashboard-page .admin-ekub-card .ekub-actions{gap:4px!important}.admin-dashboard-page .admin-ekub-card .ekub-actions .btn{font-size:.62rem!important;padding:5px 4px!important}}
@media(max-width:360px){.admin-dashboard-page .admin-stats-grid,.admin-dashboard-page .admin-ekub-grid{grid-template-columns:1fr!important}}
</style>
<script>
document.querySelectorAll('.category-filter').forEach(function(button){
  button.addEventListener('click',function(){
    document.querySelectorAll('.category-filter').forEach(function(b){
      var active=b===button;
      b.classList.toggle('active',active);
      b.setAttribute('aria-pressed',active?'true':'false');
    });
    var selected=button.dataset.category;
    document.querySelectorAll('.admin-category-group').forEach(function(group){
      var visible=selected==='all'||group.dataset.categoryGroup===selected;
      group.hidden=!visible;
      group.style.display=visible?'':'none';
    });
  });
});

document.querySelectorAll('.ekub-menu').forEach(function(menu){
  menu.addEventListener('toggle',function(){
    var card=menu.closest('.admin-ekub-card');
    if(card)card.classList.toggle('menu-open',menu.open);
    if(menu.open){
      document.querySelectorAll('.ekub-menu[open]').forEach(function(other){
        if(other!==menu)other.open=false;
      });
    }
  });
});
document.addEventListener('click',function(event){
  if(!event.target.closest('.ekub-menu')){
    document.querySelectorAll('.ekub-menu[open]').forEach(function(menu){menu.open=false;});
  }
});
document.addEventListener('keydown',function(event){
  if(event.key==='Escape')document.querySelectorAll('.ekub-menu[open]').forEach(function(menu){menu.open=false;});
});
</script>
{% endblock %}
