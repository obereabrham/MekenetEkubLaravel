{% extends 'base.twig' %}

{% block content %}
<div style="max-width: 450px; margin: 60px auto; background: var(--card-light); padding: 30px; border-radius: 16px; box-shadow: var(--shadow);">
  <h2 style="text-align: center; color: var(--primary-green); margin-bottom: 20px;">Mekenet Ekub Portal</h2>
  
  <form method="POST">{{ csrf_field() }}
    <div class="form-group">
      <label>Portal Role</label>
      <select name="login_type" class="form-control">
        <option value="admin">Super Admin</option>
        <option value="partner">Assigned Partner</option>
      </select>
    </div>
    <div class="form-group">
      <label>Username</label>
      <input type="text" name="identifier" class="form-control" required>
    </div>
    <div class="form-group">
      <label>Password</label>
      <input type="password" name="password" class="form-control" required>
    </div>
    <button type="submit" class="btn btn-primary" style="width: 100%;">Portal Login</button>
  </form>
</div>
{% endblock %}