{% extends 'base.twig' %}{% block content %}<div class="container admin-members-page"><div class="admin-tool-head"><div><span class="admin-eyebrow">ADMIN CONTROL</span><h1>Member Information</h1><p>View verified member profiles and submitted identity documents.</p></div><div class="payment-summary"><span class="payment-summary-icon">♙</span><div><strong>{{rows|length}}</strong><small>Verified members</small></div></div></div><div class="member-search" style="display:flex;gap:8px;margin:0 0 16px"><input type="search" id="memberSearch" placeholder="Search by name, username, phone, email or ID..." style="flex:1;min-width:0;padding:12px 14px;border-radius:12px;border:1px solid var(--border);background:var(--surface);color:var(--text)"><button type="button" id="memberSearchBtn" class="btn btn-primary" style="min-width:52px" aria-label="Search">&#128269;</button></div><div class="table-wrap"><table class="table"><tr><th>Profile</th><th>Name / Username</th><th>Phone</th><th>Gender/DOB</th><th>ID</th><th>Documents</th><th>Default payment method</th><th>Approved By</th></tr>{% for m in rows %}<tr data-member-row><td>{% if m.profile_picture %}<img src="{{url_for('uploads', name: m.profile_picture)}}" width="60">{% endif %}</td><td>{{m.first_name}} {{m.last_name}}<br>{{m.username}}</td><td>{{m.phone}}<br>{{m.email|default('')}}</td><td>{{m.gender}}<br>{{m.dob}}</td><td>{{m.id_type}}<br>{{m.id_number}}</td><td>{% if m.personal_photo %}<a target="_blank" href="{{url_for('uploads', name: m.personal_photo)}}">Photo</a> · {% endif %}<a target="_blank" href="{{url_for('uploads', name: m.id_front)}}">ID</a>{% if m.id_back %} · <a target="_blank" href="{{url_for('uploads', name: m.id_back)}}">Back</a>{% endif %} · <a target="_blank" href="{{url_for('uploads', name: m.video_agreement)}}">Video</a></td><td>{% if m.pm_bank %}<strong>{{m.pm_bank}}</strong><br>{{m.pm_number}}<br><small>{{m.pm_name}}</small>{% else %}—{% endif %}</td><td>{% if m.approved_by %}@{{m.approved_by}}{% else %}—{% endif %}</td></tr>{% endfor %}</table></div><p id="memberNoMatch" style="display:none;text-align:center;color:var(--muted);padding:20px">No members match your search.</p></div><script>(function(){var i=document.getElementById('memberSearch'),b=document.getElementById('memberSearchBtn');function f(){var q=(i.value||'').toLowerCase().trim().split(/\s+/).filter(Boolean),n=0;document.querySelectorAll('[data-member-row]').forEach(function(r){var t=(r.dataset.search||r.textContent).toLowerCase(),ok=q.every(function(x){return t.indexOf(x)>-1});r.style.display=ok?'':'none';if(ok)n++});var e=document.getElementById('memberNoMatch');if(e)e.style.display=n?'none':'block'}i.addEventListener('input',f);b.addEventListener('click',f);i.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();f()}})})();</script>{% endblock %}
