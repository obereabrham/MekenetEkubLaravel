{% extends 'base.twig' %}
{% block title %}Partner Sign In | Mekenet Ekub{% endblock %}
{% block content %}
<section class="auth-page">
  <div class="auth-decoration auth-decoration-one"></div><div class="auth-decoration auth-decoration-two"></div>
  <div class="auth-card">
    <div class="auth-logo"><div class="brand-icon large">M</div></div>
    <div class="auth-heading"><span class="eyebrow">PARTNER PORTAL</span><h1>Sign in to <span>Mekenet Ekub</span></h1><p>Access only the partner functions assigned by the Owner Admin.</p></div>
    <form method="POST" class="auth-form">{{ csrf_field() }}
      <div class="form-group"><label>Username, Phone or Email</label><div class="input-wrapper"><input name="identifier" required></div></div>
      <div class="form-group"><label>Password</label><div class="input-wrapper"><input type="password" name="password" required></div></div>
      <button class="btn btn-primary btn-large" type="submit">Partner Sign In</button>
    </form>
    <p class="auth-switch"><a href="{{url_for('home')}}">Return to Mekenet Ekub</a></p>
  </div>
</section>
{% endblock %}
