{% extends 'base.twig' %}
{% block content %}
<div class="container ps-detail-page">
  <div class="ps-detail-head"><div><a class="back-link" href="{{url_for('admin_payment_status')}}">← Payment Status</a><span class="admin-eyebrow">STARTED EKUB</span><h1>{{ekub.name}}</h1><p>{{ekub.category}} · {{ekub.frequency}} · Current Period {{ekub.current_period}} / {{ekub.duration}}</p></div><form method="get" class="period-pick"><label for="periodSel">Choose Period</label><select id="periodSel" name="period" onchange="this.form.submit()">{% for n in range(1,ekub.duration+1) %}<option value="{{n}}" {% if n==period %}selected{% endif %}>Period {{n}}{% if n==ekub.current_period %} (current){% endif %}</option>{% endfor %}</select></form></div>
  {% set unpaid_n = members|rejectattr('bal.fully_paid')|list|length %}
  {% if me and me.role == 'admin' %}<form method="post" action="{{url_for('admin_send_payment_reminder', ekub_id: ekub.id)}}" class="remind-bar">{{ csrf_field() }}
    <input type="hidden" name="period" value="{{period}}">
    <span>{{unpaid_n}} unpaid member{% if unpaid_n != 1 %}s{% endif %} for Period {{period}}</span>
    <button type="submit" class="remind-btn" {% if not unpaid_n %}disabled{% endif %}>Send Payment Reminder</button>
  </form>{% endif %}
  <div class="member-payment-list">
  {% for m in members %}
    <article class="member-payment-card">
      <div class="member-avatar">{{(m.first_name|default('M'))|slice(0, 1)|upper}}</div>
      <div class="member-main"><h3>{{m.first_name}} {{m.last_name}}</h3><span>@{{m.username}}</span><small>{{m.phone}}{% if m.email %} · {{m.email}}{% endif %}</small></div>
      <div class="member-money"><small>Contribution</small><strong>{{'%.2f'|format(m.contribution_amount|default(0))}} ETB</strong><span>{{m.share_type}}</span></div>
      <div class="member-payment"><small>Period {{period}}</small>{% if m.payment_status == 'approved' %}<b class="paid">PAID</b>{% elseif m.payment_status == 'pending' %}<b class="pending">PENDING</b>{% elseif m.payment_status == 'partial' %}<b class="pending">PARTIAL</b>{% elseif m.payment_status == 'rejected' %}<b class="rejected">REJECTED</b>{% else %}<b class="unpaid">UNPAID</b>{% endif %}<span>Paid {{'%.2f'|format(m.bal.paid)}} · Left {{'%.2f'|format(m.bal.left)}} ETB</span>{% if m.bal.pending>0 %}<span>Pending review: {{'%.2f'|format(m.bal.pending)}} ETB</span>{% endif %}{% if m.bal.penalty>0 %}<em class="approved-by rejected-by">Penalty: {{'%.2f'|format(m.bal.penalty)}} ETB ({{m.bal.days_late}}d late)</em>{% endif %}</div>
      <div class="member-actions">{% if m.payments %}{% for pp in m.payments %}<div class="payment-proof">{% if pp.screenshot %}<a href="{{url_for('uploads', name: pp.screenshot)}}" target="_blank" class="member-btn">Receipt {{loop.index}} · {{'%.2f'|format(pp.amount)}} ETB ↗</a>{% endif %}<small>{{pp.method}} · Transaction: {{pp.transaction_no}} · {{pp.status|capitalize}}</small>{% if pp.payment_currency == 'USDT' and pp.payment_currency_amount %}<small>Submitted {{'%.8f'|format(pp.payment_currency_amount)}} USDT · Rate {{'%.4f'|format(pp.payment_exchange_rate)}} ETB/USDT</small>{% endif %}</div>{% endfor %}{% else %}<span class="member-no-payment">No payment</span>{% endif %}</div>
    </article>
  {% else %}<div class="ps-empty"><h2>No members joined</h2></div>{% endfor %}
  </div>
</div>
<style>
.remind-bar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px;padding:14px 18px;border:1px solid var(--border);background:var(--surface);border-radius:16px}.remind-bar span{color:var(--muted);font-size:13px;font-weight:700}.remind-btn{padding:11px 18px;border:0;border-radius:12px;background:linear-gradient(135deg,var(--green),var(--blue));color:#fff;font-weight:800;cursor:pointer}.remind-btn:disabled{opacity:.5;cursor:not-allowed}
.period-pick{display:flex;flex-direction:column;gap:6px}.period-pick label{font-size:10px;font-weight:900;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}.period-pick select{padding:11px 14px;border-radius:12px;border:1px solid var(--border);background:var(--surface);color:var(--text);font-weight:800;font-size:13px;cursor:pointer}
.ps-detail-page{max-width:1220px;padding:35px 20px 70px}.ps-detail-head{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:24px}.back-link{display:inline-block;color:var(--green);text-decoration:none;font-weight:800;font-size:12px;margin-bottom:15px}.ps-detail-head h1{margin:3px 0;color:var(--text)}.ps-detail-head p{margin:0;color:var(--muted)}.period-badge{padding:12px 16px;border-radius:14px;background:var(--green-light);color:var(--green-dark);font-weight:900;font-size:12px}.member-payment-list{display:grid;gap:12px}.member-payment-card{display:grid;grid-template-columns:48px 1.6fr 1fr .8fr auto;align-items:center;gap:16px;padding:16px 18px;background:var(--surface);border:1px solid var(--border);border-radius:17px;box-shadow:var(--shadow)}.member-avatar{width:44px;height:44px;display:grid;place-items:center;border-radius:13px;background:linear-gradient(135deg,var(--green),var(--blue));color:#fff;font-weight:900}.member-main h3{margin:0;color:var(--text);font-size:14px}.member-main span,.member-main small,.member-money span,.member-payment span{display:block;color:var(--muted);font-size:11px;margin-top:3px}.member-payment .approved-by{display:block;color:var(--green-dark);font-size:10px;font-style:normal;font-weight:800;margin-top:5px}.member-payment .rejected-by{color:#b42318}.member-money small,.member-payment small,.payment-proof small{display:block;color:var(--muted);font-size:10px;margin-top:5px;overflow-wrap:anywhere}.member-money strong{display:block;color:var(--text);margin-top:4px}.member-payment b{display:block;margin-top:4px;font-size:11px}.paid{color:#16a05a}.pending{color:#b7791f}.rejected{color:#d34c4c}.unpaid{color:#dc7a1d}.member-btn{display:inline-flex;padding:9px 12px;border-radius:10px;background:var(--surface-2);border:1px solid var(--border);color:var(--text);text-decoration:none;font-weight:800;font-size:11px}.payment-proof{display:grid;justify-items:start;gap:4px;margin:4px 0}.retry-check-btn{padding:8px 11px;border:1px solid var(--border);border-radius:10px;background:var(--surface-2);color:var(--text);font-size:11px;font-weight:800;cursor:pointer}.member-no-payment{font-size:11px;color:var(--muted)}@media(max-width:850px){.member-payment-card{grid-template-columns:44px 1fr 1fr}.member-actions{grid-column:2/-1}.ps-detail-head{align-items:flex-start;flex-direction:column}}@media(max-width:560px){.member-payment-card{grid-template-columns:44px 1fr}.member-money,.member-payment,.member-actions{grid-column:2}.member-money{margin-top:4px}}
</style>
{% endblock %}
