{% extends 'base.twig' %}
{% block title %}Merchant review | Mekenet Ekub{% endblock %}
{% block content %}
<main class="merchant-admin-page">
  <header class="merchant-page-heading"><div><span class="merchant-kicker">Admin portal</span><h1>Merchant applications</h1><p>Verify business details and review merchant earnings. Admins continue to control payments and KYC.</p></div><a class="btn ghost" href="{{url_for('admin_dashboard')}}">Back to dashboard</a></header>
  <section class="merchant-metrics"><article><span>Pending review</span><strong>{{pending_count}}</strong></article><article><span>Approved merchants</span><strong>{{approved_count}}</strong></article><article><span>Applications</span><strong>{{merchants|length}}</strong></article></section>
  {% if merchants %}<div class="merchant-admin-grid">{% for merchant in merchants %}
    <article class="merchant-admin-card"><div class="merchant-card-top"><div><span class="merchant-kicker">{{merchant.category}}</span><h2>{{merchant.business_name}}</h2></div><span class="merchant-status {{merchant.status}}">{{merchant.status}}</span></div>
      <dl><dt>TIN</dt><dd>{{merchant.tin}}</dd><dt>Contact</dt><dd>{{merchant.contact_name}}</dd><dt>Phone</dt><dd>{{merchant.business_phone}}</dd><dt>Email</dt><dd>{{merchant.business_email|default('Not provided')}}</dd><dt>Address</dt><dd>{{merchant.address}}</dd><dt>Account</dt><dd>@{{merchant.username}} · {{merchant.account_phone}}</dd><dt>Current Ekubs</dt><dd>{{merchant.ekub_count}}</dd><dt>Pending commission</dt><dd>{{merchant.commission_pending|number_format(2)}} ETB</dd></dl>
      {% if merchant.website_url %}<a href="{{merchant.website_url}}" target="_blank" rel="noopener">{{merchant.website_url}}</a>{% endif %}
      {% if merchant.location_lat is not null and merchant.location_lng is not null %}<a class="merchant-map-mini" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&amp;query={{merchant.location_lat}},{{merchant.location_lng}}">⌖ {{merchant.address}} · Open map ↗</a>{% endif %}
      {% if merchant.tin_document_url %}<a class="merchant-document" href="{{merchant.tin_document_url}}" target="_blank" rel="noopener">View TIN document ↗</a>{% endif %}
      {% if merchant.status == 'pending' %}<div class="merchant-admin-actions"><form method="post" action="{{url_for('admin_merchant_decision', merchant_id: merchant.id, action: 'approve')}}">{{csrf_field()}}<button class="btn" type="submit">Approve merchant</button></form><form method="post" action="{{url_for('admin_merchant_decision', merchant_id: merchant.id, action: 'reject')}}">{{csrf_field()}}<input name="reason" placeholder="Reason required" maxlength="500" required><button class="btn danger" type="submit">Reject</button></form></div>{% elseif merchant.rejection_reason %}<p class="merchant-rejection">Review note: {{merchant.rejection_reason}}</p>{% endif %}
    </article>
  {% endfor %}</div>{% else %}<div class="merchant-empty">No merchant applications yet.</div>{% endif %}
  <section class="merchant-commissions"><div><span class="merchant-kicker">Payout records</span><h2>Merchant commissions</h2><p>Each merchant Ekub payout allocates 1.5% to the platform and 0.5% to the merchant from the 2% service fee. Admin review controls recorded payouts.</p></div>
    {% if commissions %}<div class="merchant-table-wrap"><table><thead><tr><th>Merchant</th><th>Ekub</th><th>Period</th><th>Gross</th><th>0.5% commission</th><th>Status</th><th>Action</th></tr></thead><tbody>{% for row in commissions %}<tr><td>{{row.business_name}}</td><td>{{row.ekub_name}}</td><td>{{row.period_no}}</td><td>{{row.gross_amount|number_format(2)}} ETB</td><td>{{row.commission_amount|number_format(2)}} ETB</td><td>{{row.status}}</td><td>{% if row.status == 'pending' %}<form method="post" action="{{url_for('admin_merchant_commission_paid', commission_id: row.id)}}">{{csrf_field()}}<button class="btn" type="submit">Mark paid</button></form>{% else %}{{row.paid_at|date('d M Y')}}{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="merchant-empty">No merchant commissions yet.</div>{% endif %}
  </section>
</main>
<style>.merchant-admin-page{width:min(1500px,calc(100% - 48px));margin:42px auto 70px;color:var(--text)}.merchant-page-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:26px}.merchant-page-heading h1{font-size:clamp(2rem,4vw,3.2rem);margin:8px 0}.merchant-page-heading p,.merchant-admin-card dl{color:var(--muted)}.merchant-kicker{color:#4ed58c;font-size:.78rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.merchant-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:20px}.merchant-metrics article,.merchant-admin-card,.merchant-commissions,.merchant-empty{background:var(--panel,rgba(255,255,255,.04));border:1px solid var(--border);border-radius:22px;padding:22px}.merchant-metrics article{display:grid;gap:9px;color:var(--muted)}.merchant-metrics strong{font-size:2rem;color:var(--text)}.merchant-admin-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:17px}.merchant-admin-card h2{margin:5px 0 12px}.merchant-card-top{display:flex;justify-content:space-between;gap:10px}.merchant-status{height:max-content;padding:7px 12px;border-radius:999px;background:#d7f4e1;color:#176936;font-weight:800;text-transform:capitalize}.merchant-status.pending{background:#fff1cc;color:#835400}.merchant-status.rejected{background:#ffe0e0;color:#a33}.merchant-admin-card dl{display:grid;grid-template-columns:135px 1fr;gap:8px 12px}.merchant-admin-card dt{font-weight:700}.merchant-admin-card dd{margin:0;color:var(--text);overflow-wrap:anywhere}.merchant-map-mini,.merchant-document{display:block;margin:12px 0;padding:12px;border-radius:13px;background:rgba(91,184,132,.12);color:inherit}.merchant-admin-actions{display:grid;gap:10px;margin-top:16px}.merchant-admin-actions form{display:flex;gap:8px;flex-wrap:wrap}.merchant-admin-actions input{flex:1;min-width:180px}.merchant-admin-actions button{flex:1}.merchant-commissions{margin-top:24px}.merchant-commissions h2{margin:6px 0}.merchant-commissions p,.merchant-rejection{color:var(--muted)}.merchant-empty{text-align:center;padding:56px}.btn.danger{background:#ac3c49;color:white}@media(max-width:720px){.merchant-admin-page{width:calc(100% - 28px);margin:25px auto}.merchant-page-heading{align-items:flex-start;flex-direction:column}.merchant-metrics{grid-template-columns:1fr}.merchant-admin-card dl{grid-template-columns:105px 1fr}}</style>
{% endblock %}
