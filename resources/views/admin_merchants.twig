{% extends 'base.twig' %}
{% block content %}
<div class="container merchant-admin-page">
  <header class="merchant-head"><div><span class="merchant-eyebrow">ADMIN PORTAL</span><h1>Merchant review</h1><p>Verify merchant applications and track the merchant share of the Ekub service fee.</p></div></header>
  <section class="merchant-list">
    {% for merchant in rows %}
    <article class="card merchant-review-card">
      <div class="merchant-review-title"><div><h2>{{merchant.business_name}}</h2><span>@{{merchant.username}} · {{merchant.first_name}} {{merchant.last_name}}</span></div><span class="merchant-status {{merchant.status}}">{{merchant.status|capitalize}}</span></div>
      <div class="merchant-facts"><div><small>TIN</small><b>{{merchant.tin}}</b></div><div><small>Category</small><b>{{merchant.category}}</b></div><div><small>Business phone</small><b>{{merchant.business_phone}}</b></div><div><small>Address</small><b>{{merchant.address}}</b></div><div><small>Website</small><b>{{merchant.website|default('—')}}</b></div><div><small>Location</small><b>{{merchant.location|default('—')}}</b></div></div>
      {% if merchant.status == 'pending' %}<div class="merchant-actions"><form method="post" action="{{url_for('merchant_admin_action', merchant_id: merchant.id, action: 'approve')}}">{{csrf_field()}}<button class="btn">Approve merchant</button></form><form method="post" action="{{url_for('merchant_admin_action', merchant_id: merchant.id, action: 'reject')}}">{{csrf_field()}}<input name="reason" required placeholder="Reason for rejection"><button class="btn danger">Reject</button></form></div>{% elseif merchant.rejection_reason %}<p class="merchant-rejection">Reason: {{merchant.rejection_reason}}</p>{% endif %}
    </article>
    {% else %}<div class="card merchant-empty"><h2>No merchant applications yet</h2></div>{% endfor %}
  </section>
  <section class="merchant-commissions"><div class="merchant-section-head"><h2>Pending merchant commissions</h2><p>Each approved pool has 1.5% recorded for the platform and 0.5% for the merchant. Mark a commission paid only after the transfer is completed.</p></div>
    {% for commission in commissions %}<article class="card commission-row"><div><b>{{commission.business_name}}</b><span>{{commission.ekub_name}} · {{commission.created_at}}</span></div><div><small>Gross pool</small><b>{{commission.gross_amount}} ETB</b></div><div><small>Merchant 0.5%</small><b>{{commission.amount}} ETB</b></div><div><small>Platform 1.5%</small><b>{{commission.admin_amount}} ETB</b></div><form method="post" action="{{url_for('merchant_commission_paid', commission_id: commission.id)}}">{{csrf_field()}}<button class="btn" type="submit">Mark commission paid</button></form></article>
    {% else %}<div class="card merchant-empty"><p>No unpaid merchant commissions.</p></div>{% endfor %}
  </section>
</div>
<style>
.merchant-admin-page{max-width:1180px}.merchant-head{margin:26px 0}.merchant-eyebrow{font-size:.75rem;letter-spacing:.14em;font-weight:900;color:#22b66d}.merchant-head h1{margin:.3rem 0}.merchant-head p,.merchant-section-head p{opacity:.68}.merchant-list{display:grid;gap:15px}.merchant-review-card{padding:20px;border-radius:18px}.merchant-review-title{display:flex;justify-content:space-between;align-items:start;gap:12px}.merchant-review-title h2{margin:0 0 5px}.merchant-review-title span:not(.merchant-status){opacity:.68}.merchant-status{padding:7px 11px;border-radius:30px;background:rgba(130,130,130,.14);font-weight:800;font-size:.8rem}.merchant-status.pending{color:#9a6800;background:#fff4cf}.merchant-status.approved{color:#16803c;background:#e3f6e9}.merchant-status.rejected{color:#b42318;background:#ffe8e8}.merchant-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:17px 0}.merchant-facts div{display:grid;gap:4px;padding:11px;border-radius:12px;background:rgba(128,128,128,.07);overflow-wrap:anywhere}.merchant-facts small,.commission-row small{opacity:.6}.merchant-actions{display:flex;gap:12px;flex-wrap:wrap}.merchant-actions form{display:flex;gap:8px;flex-wrap:wrap}.merchant-actions input{min-width:220px;padding:10px 12px;border-radius:12px;border:1px solid rgba(128,128,128,.28);background:transparent;color:inherit}.btn.danger{background:#ba3442}.merchant-rejection{color:#bd4553}.merchant-commissions{margin:34px 0}.merchant-section-head h2{margin-bottom:5px}.commission-row{display:grid;grid-template-columns:1.2fr repeat(3,minmax(110px,.7fr)) auto;gap:14px;align-items:center;margin:10px 0;padding:15px}.commission-row>div,.commission-row:first-child>div{display:grid;gap:5px}.commission-row>div:first-child span{opacity:.65;font-size:.87rem}.merchant-empty{padding:28px;text-align:center}@media(max-width:850px){.commission-row{grid-template-columns:repeat(2,minmax(0,1fr))}.commission-row form{grid-column:1/-1}.merchant-facts{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:480px){.merchant-facts{grid-template-columns:1fr}.merchant-review-title{flex-direction:column}.commission-row{grid-template-columns:1fr}}
</style>
{% endblock %}
