{% extends 'base.twig' %}
{% block title %}Full Ekubs | Mekenet Ekub{% endblock %}
{% block content %}
<main class="container full-ekubs-page">
  <div class="page-head">
    <div>
      <div class="eyebrow">ADMIN MANAGEMENT</div>
      <h1>Full Ekubs</h1>
      <p>Full Ekubs stay here until you start them. Started Ekubs move to Pick Winners when every member has paid the current period.</p>
    </div>
    <a class="btn ghost" href="{{url_for('admin_dashboard')}}">← Admin Dashboard</a>
  </div>

  {% if ekubs %}
    {% for category, category_ekubs in ekubs|groupby('category') %}
      <section class="full-category">
        <h2>{{category}} <span>{{category_ekubs|length}}</span></h2>
        <div class="full-grid">
          {% for e in category_ekubs %}
            <article class="full-card">
              <div class="card-head">
                <span class="full-label">✓ Full capacity</span>
                <span class="status status-{{e.status|lower}}">{{e.status|capitalize}}</span>
              </div>
              <h3>{{e.name}}</h3>
              <div class="meta-grid">
                <div><small>Contribution</small><strong>{{e.base_amount}} ETB</strong></div>
                <div><small>Frequency</small><strong>{{e.frequency}}</strong></div>
                <div><small>Members</small><strong>{{e.joined_count}}</strong></div>
                <div><small>Periods</small><strong>{{e.duration}}</strong></div>
                {% if e.status == 'started' %}<div><small>Current period</small><strong>{{e.current_period}}</strong></div>{% endif %}
              </div>
              <div class="card-links">
                <a class="btn ghost" href="{{url_for('admin_ekub_information', ekub_id: e.id)}}">Information</a>
                <a class="btn ghost" href="{{url_for('ekub_detail', ekub_id: e.id)}}">Details</a>
              </div>
              <form method="post" action="{{url_for('start_ekub', ekub_id: e.id)}}">{{csrf_field()}}<button class="btn wide" type="submit">Start Ekub</button></form>
            </article>
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  {% else %}
    <section class="empty card">
      <div class="empty-icon">✓</div>
      <h2>No full Ekubs waiting to start</h2>
      <p>When an open Ekub reaches capacity, it will appear here. Started Ekubs move to Pick Winners.</p>
      <a class="btn ghost" href="{{url_for('admin_dashboard')}}">View open Ekubs</a>
      <a class="btn ghost" href="{{url_for('admin_pick_winners')}}">View ready winners</a>
    </section>
  {% endif %}
</main>
<style>
.full-ekubs-page{padding-top:22px;padding-bottom:40px}.page-head{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px}.page-head h1{margin:.15rem 0}.page-head p{max-width:680px;margin:6px 0 0;color:var(--muted,#738078);line-height:1.55}.eyebrow{font-size:.72rem;font-weight:800;letter-spacing:.12em;opacity:.65}.full-category{margin:26px 0}.full-category h2{display:flex;align-items:center;gap:10px;font-size:1.15rem}.full-category h2 span{padding:3px 9px;border-radius:999px;background:rgba(34,177,112,.13);color:#168653;font-size:.78rem}.full-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.full-card{min-width:0;padding:17px;border:1px solid rgba(34,177,112,.22);border-radius:18px;background:linear-gradient(145deg,var(--surface,#fff),color-mix(in srgb,var(--surface,#fff) 92%,#22b170));box-shadow:0 8px 24px rgba(0,0,0,.06)}.card-head{display:flex;align-items:center;justify-content:space-between;gap:8px}.full-label,.status{padding:5px 9px;border-radius:999px;font-size:.72rem;font-weight:800}.full-label{background:rgba(34,177,112,.14);color:#168653}.status{background:rgba(127,127,127,.12)}.status-started{background:rgba(39,162,224,.14);color:#0878a9}.full-card h3{margin:13px 0;font-size:1.1rem;overflow-wrap:anywhere}.meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin:15px 0}.meta-grid div{display:grid;gap:3px}.meta-grid small{color:var(--muted,#738078)}.meta-grid strong{font-size:.9rem}.card-links,.card-actions{display:flex;gap:8px;flex-wrap:wrap}.card-links{margin-bottom:9px}.card-links .btn,.card-actions .btn{flex:1;text-align:center;min-width:120px}.full-card form .wide{width:100%}.card-actions{display:grid}.btn:disabled{opacity:.55;cursor:not-allowed}.empty{text-align:center;padding:44px 18px}.empty-icon{display:grid;place-items:center;width:54px;height:54px;margin:0 auto 13px;border-radius:18px;background:rgba(34,177,112,.13);color:#168653;font-size:1.8rem}.empty h2{margin:0 0 6px}.empty p{margin:0 0 18px;color:var(--muted,#738078)}@media(max-width:900px){.full-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.page-head{align-items:flex-start;flex-direction:column}.full-grid{grid-template-columns:1fr}}
</style>
{% endblock %}
