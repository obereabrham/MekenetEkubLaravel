{% extends 'base.twig' %}
{% block title %}Recently Winner | Mekenet Ekub{% endblock %}
{% block content %}
<div class="container rw-page">
  <div class="rw-head">
    <div>
      <span class="admin-eyebrow">PRIZE PAYOUTS</span>
      <h1>Recently Winner</h1>
      <p>Send each winner's prize money manually, then press <b>Send</b>. The winner is removed from this list once sent.</p>
    </div>
    <div class="rw-count"><strong>{{rows|length}}</strong><span>Waiting to be sent</span></div>
  </div>

  <div class="rw-list">
  {% for w in rows %}
    <article class="rw-card">
      <div class="rw-person">
        <div class="rw-avatar">{{(w.first_name|default('W'))|slice(0, 1)|upper}}</div>
        <div>
          <h3>{{w.first_name}} {{w.last_name}}</h3>
          <span>@{{w.username}}</span>
          <small>{{w.phone}}{% if w.email %} · {{w.email}}{% endif %}</small>
          <small>KYC: {{w.kyc_status|replace('_',' ')|title}}</small>
        </div>
      </div>

      <div class="rw-info">
        <small>MEMBER INFORMATION</small>
        <div><span>Full name (KYC)</span><b>{{w.kyc_name|default(w.first_name ~ ' ' ~ w.last_name)}}</b></div>
        <div><span>Gender / Birth date</span><b>{{w.gender|default('—')}} · {{w.dob|default('—')}}</b></div>
        <div><span>ID</span><b>{{w.id_type|default('—')}}{% if w.id_number %} · {{w.id_number}}{% endif %}</b></div>
      </div>

      <div class="rw-info">
        <small>WON</small>
        <div><span>Ekub</span><b>{{w.ekub_name}}</b></div>
        <div><span>Period</span><b>{{w.period_no}} · {{w.frequency}}</b></div>
        <div><span>Date</span><b>{{(w.created_at|default(''))|slice(0, 16)}}</b></div>
      </div>

      <div class="rw-info rw-money">
        <small>AMOUNT TO SEND</small>
        <strong>{{format_amount(w.net_amount)}} ETB</strong>
        <div><span>Gross</span><b>{{format_amount(w.gross_amount)}}</b></div>
        <div><span>Service fee (2%)</span><b>− {{format_amount(w.service_fee)}}</b></div>
      </div>

      <div class="rw-info rw-bank">
        <small>SEND TO</small>
        {% if w.pm_bank %}
        <div><span>Bank</span><b>{{w.pm_bank}}</b></div>
        <div><span>Account</span><b>{{w.pm_number}}</b></div>
        <div><span>Name</span><b>{{w.pm_name}}</b></div>
        {% else %}
        <div class="rw-nobank">No payment method saved. Contact the winner on {{w.phone}}.</div>
        {% endif %}
      </div>

      <form method="post" action="{{url_for('recent_winner_send', payout_id: w.payout_id)}}" class="rw-send"
            data-confirm="Did you already send {{format_amount(w.net_amount)}} ETB to {{w.first_name}} {{w.last_name}}? Pressing Yes removes this winner from the list." data-confirm-ok="Yes, I sent it" data-confirm-danger="false">{{ csrf_field() }}
        <button type="submit" class="rw-send-btn">Send ✓</button>
      </form>
    </article>
  {% else %}
    <div class="rw-empty"><div>✓</div><h3>No winners waiting</h3><p>Every winner's prize money has been sent.</p></div>
  {% endfor %}
  </div>
</div>
<style>
.rw-page{max-width:1280px;padding:35px 20px 70px}
.rw-head{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:24px;flex-wrap:wrap}
.rw-head h1{margin:5px 0;color:var(--text)}.rw-head p{margin:0;color:var(--muted)}
.rw-count{padding:14px 20px;border:1px solid var(--border);background:var(--surface);border-radius:16px;text-align:center;box-shadow:var(--shadow)}
.rw-count strong{display:block;font-size:24px;color:var(--text)}.rw-count span{font-size:11px;color:var(--muted)}
.rw-list{display:grid;gap:14px}
.rw-card{display:grid;grid-template-columns:1.3fr 1.2fr 1fr 1fr 1.1fr auto;gap:18px;align-items:center;padding:18px;background:var(--surface);border:1px solid var(--border);border-radius:18px;box-shadow:var(--shadow)}
.rw-person{display:flex;gap:12px;align-items:center}
.rw-avatar{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(135deg,var(--green),var(--blue));color:#fff;font-weight:900;flex:none}
.rw-person h3{margin:0;font-size:14px;color:var(--text)}.rw-person span,.rw-person small{display:block;color:var(--muted);font-size:11px;margin-top:3px}
.rw-info{display:grid;gap:4px;font-size:12px}.rw-info>small{font-size:10px;font-weight:900;letter-spacing:.06em;color:var(--muted);margin-bottom:2px}
.rw-info div{display:flex;flex-direction:column}.rw-info div span{font-size:10px;color:var(--muted)}.rw-info div b{color:var(--text);font-weight:800;word-break:break-word}
.rw-money strong{font-size:1.3rem;color:#0a8f3d;font-weight:900}.rw-nobank{color:#b42318;font-weight:700;font-size:11px}
.rw-send-btn{padding:13px 24px;border:0;border-radius:12px;background:linear-gradient(135deg,var(--green),var(--blue));color:#fff;font-weight:900;cursor:pointer;font-size:14px;white-space:nowrap}
.rw-send-btn:hover{filter:brightness(1.07);transform:translateY(-1px)}
.rw-empty{text-align:center;padding:60px 20px;background:var(--surface);border:1px solid var(--border);border-radius:20px}
.rw-empty div{width:54px;height:54px;margin:0 auto 12px;display:grid;place-items:center;border-radius:16px;background:linear-gradient(135deg,var(--green),var(--blue));color:#fff;font-size:24px}
.rw-empty h3{color:var(--text)}.rw-empty p{color:var(--muted)}
@media(max-width:1100px){.rw-card{grid-template-columns:1fr 1fr}.rw-send{grid-column:1/-1}.rw-send-btn{width:100%}}
@media(max-width:600px){.rw-card{grid-template-columns:1fr}}
</style>
{% endblock %}
