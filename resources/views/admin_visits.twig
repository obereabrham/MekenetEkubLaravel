{% extends 'base.twig' %}
{% block title %}Visits | Mekenet Ekub{% endblock %}
{% block content %}
<main class="admin-visits-page">
  <header class="visits-heading">
    <div>
      <span class="visits-eyebrow">ADMIN PORTAL</span>
      <h1>App &amp; Website Visits</h1>
      <p>Compare unique visitors, signed-in members, and other visitors for each period.</p>
    </div>
    <a class="visits-back" href="{{url_for('admin_dashboard')}}">Back to dashboard</a>
  </header>

  {% if not available %}
  <div class="visits-alert">Visit tracking tables are not installed yet. Run <code>php artisan migrate</code> in the project folder.</div>
  {% endif %}

  <section class="visits-summary" aria-label="Membership and review summary">
    <article class="visits-summary-card">
      <span>Registered members</span>
      <strong>{{registered_members}}</strong>
      <small>All registered member accounts</small>
    </article>
    <article class="visits-summary-card visits-rating-card">
      <span>Website rating</span>
      {% if rating_count > 0 %}
        <strong>{{rating_average}} <small>/ 5</small></strong>
        <small>{{rating_count}} rating{% if rating_count != 1 %}s{% endif %}</small>
      {% else %}
        <strong>— <small>/ 5</small></strong>
        <small>No reviews yet</small>
      {% endif %}
    </article>
  </section>

  {% set periods = {'day':'Daily', 'week':'Weekly', 'month':'Monthly', 'year':'Yearly'} %}
  <section class="visits-period-grid" aria-label="Visitor counts by period">
    {% for period_key, period_label in periods %}
      {% set metrics = summary[period_key] %}
      <article class="visits-period-card">
        <h2>{{period_label}}</h2>

        <div class="visits-platform-row app-visits-row">
          <span class="visits-dot" aria-hidden="true"></span>
          <span>App visitors</span>
          <strong>{{metrics.app.total}}</strong>
        </div>
        <div class="visits-detail-row"><span>Signed-in members</span><strong>{{metrics.app.members}}</strong></div>
        <div class="visits-detail-row"><span>Other visitors</span><strong>{{metrics.app.guests}}</strong></div>

        <div class="visits-platform-row website-visits-row">
          <span class="visits-dot" aria-hidden="true"></span>
          <span>Website visitors</span>
          <strong>{{metrics.website.total}}</strong>
        </div>
        <div class="visits-detail-row"><span>Signed-in members</span><strong>{{metrics.website.members}}</strong></div>
        <div class="visits-detail-row"><span>Other visitors</span><strong>{{metrics.website.guests}}</strong></div>

        <div class="visits-new-members-row">
          <span class="visits-dot" aria-hidden="true"></span>
          <span>New members</span>
          <strong>{{metrics.new_members}}</strong>
        </div>
      </article>
    {% endfor %}
  </section>

  <p class="visits-footnote">Visitors are counted once per account or anonymous browser/device identifier during the selected period. Anonymous identifiers are stored as hashes.</p>
</main>

<style>
.admin-visits-page{width:min(1745px,calc(100% - 64px));margin:44px auto 72px;color:var(--text)}
.visits-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;margin-bottom:30px}
.visits-heading h1{margin:12px 0 8px;font-size:clamp(2.1rem,4vw,3rem);line-height:1.12;letter-spacing:-.035em}
.visits-heading p{margin:0;color:var(--muted);font-size:1.05rem;line-height:1.55}
.visits-eyebrow{color:#36d982;font-size:.78rem;font-weight:900;letter-spacing:.16em}
.visits-back{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 25px;border:1px solid var(--border);border-radius:16px;background:var(--surface-2);color:var(--text);font-weight:800;text-decoration:none;transition:transform .18s,border-color .18s}
.visits-back:hover{transform:translateY(-2px);border-color:#43b5d4}
.visits-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-bottom:24px}
.visits-summary-card{min-height:178px;padding:26px 30px;border:1px solid var(--border);border-radius:26px;background:linear-gradient(135deg,color-mix(in srgb,var(--surface) 90%,#43b5d4 10%),var(--surface));box-shadow:0 15px 36px rgba(0,0,0,.08);display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:10px}
.visits-summary-card>span{color:var(--muted);font-size:1.15rem;font-weight:700}
.visits-summary-card>strong{font-size:2.8rem;line-height:1;font-weight:900;letter-spacing:-.04em}
.visits-summary-card>small{color:var(--muted);font-size:.93rem}
.visits-rating-card{background:linear-gradient(135deg,color-mix(in srgb,var(--surface) 90%,#88b44a 10%),var(--surface))}
.visits-rating-card>strong small{font-size:1.2rem;color:var(--muted);letter-spacing:0}
.visits-alert{margin:-8px 0 22px;padding:14px 17px;border:1px solid #f2c66d;border-radius:14px;background:#fff8e7;color:#754c00}
.visits-period-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;align-items:stretch}
.visits-period-card{min-width:0;padding:24px 24px 20px;border:1px solid var(--border);border-radius:25px;background:linear-gradient(145deg,color-mix(in srgb,var(--surface) 94%,#88b44a 6%),var(--surface));box-shadow:0 12px 30px rgba(0,0,0,.07)}
.visits-period-card h2{margin:0 0 20px;padding-bottom:22px;border-bottom:1px solid var(--border);font-size:1.4rem;font-weight:850}
.visits-platform-row,.visits-detail-row,.visits-new-members-row{display:grid;grid-template-columns:18px minmax(0,1fr) auto;align-items:center;gap:10px;min-height:59px;padding:8px 0;border-bottom:1px solid color-mix(in srgb,var(--border) 75%,transparent)}
.visits-platform-row{font-size:1.12rem}
.visits-platform-row strong,.visits-new-members-row strong{font-size:1.18rem;font-weight:900}
.visits-detail-row{grid-template-columns:minmax(0,1fr) auto;padding-left:26px;color:var(--muted);font-size:.98rem}
.visits-detail-row strong{font-weight:800;color:var(--muted)}
.visits-dot{width:14px;height:14px;border-radius:50%;background:#43b5d4}
.website-visits-row{margin-top:8px}
.website-visits-row .visits-dot{background:#88b44a}
.visits-new-members-row{margin-top:8px;border-bottom:0;font-size:1.12rem}
.visits-new-members-row .visits-dot{background:#ae7af3}
.visits-footnote{margin:20px 2px 0;color:var(--muted);font-size:.85rem;line-height:1.5}
@media(max-width:1300px){.visits-period-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.admin-visits-page{width:calc(100% - 32px);margin:26px auto 54px}.visits-heading{align-items:flex-start;flex-direction:column;margin-bottom:22px}.visits-back{width:100%;box-sizing:border-box}.visits-summary{gap:12px}.visits-summary-card{min-height:138px;padding:18px;border-radius:20px}.visits-summary-card>span{font-size:.95rem}.visits-summary-card>strong{font-size:2.2rem}.visits-period-grid{gap:12px}.visits-period-card{padding:19px 17px;border-radius:20px}.visits-period-card h2{padding-bottom:16px;margin-bottom:12px;font-size:1.2rem}.visits-platform-row,.visits-new-members-row{font-size:.95rem}.visits-detail-row{font-size:.85rem}}
@media(max-width:520px){.visits-summary{grid-template-columns:1fr}.visits-summary-card{min-height:120px}.visits-period-grid{grid-template-columns:1fr}.visits-period-card{padding:20px}.visits-platform-row,.visits-new-members-row{min-height:53px}}
</style>
{% endblock %}
