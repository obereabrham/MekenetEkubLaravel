{% extends 'base.twig' %}{% block content %}<div class="card form-card"><h1>Join {{ekub.name}}</h1><p>Base amount: {{ekub.base_amount}} ETB. Choose your share.</p><form method="post">{{ csrf_field() }}{% if ekub.is_item %}<input type="hidden" name="share_type" value="full"><div class="card"><b>Item Ekub is Full Share only.</b></div>{% else %}<label>Share Type</label><select name="share_type"><option value="full">Full — {{ekub.base_amount}} ETB</option><option value="half">Half — {{ekub.base_amount*0.5}} ETB</option><option value="quarter">Quarter — {{ekub.base_amount*0.25}} ETB</option></select>{% endif %}<button class="btn">Confirm Join</button></form></div>{% endblock %}
