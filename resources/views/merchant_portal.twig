{% extends 'base.twig' %}
{% block content %}
<div class="container merchant-portal">
  <header class="merchant-portal-head"><div><span>MEKENET EKUB · BUSINESS</span><h1>Merchant</h1><p>Manage your merchant application, Ekubs, invited members and product promotions.</p></div>{% if merchant and merchant.status == 'approved' %}<div class="merchant-approved">✓ Approved merchant</div>{% endif %}</header>
  {% if not merchant or merchant.status != 'approved' %}
    {% if merchant and merchant.status == 'pending' %}<div class="card merchant-state pending"><b>Application under review</b><p>Your submitted business details and TIN are waiting for admin approval.</p></div>
    {% elseif merchant and merchant.status == 'rejected' %}<div class="card merchant-state rejected"><b>Application needs changes</b><p>{{merchant.rejection_reason|default('Review your details and submit again.')}}</p></div>{% endif %}
    {% if kyc_status|default('not_submitted') != 'approved' %}
    <section class="card merchant-state pending"><b>Identity verification approval required</b><p>Submit your KYC and wait for admin approval before applying for a merchant account.</p><a class="btn" href="{{url_for('kyc')}}">Open identity verification</a></section>
    {% else %}
    <section class="card merchant-form-card"><h2>{% if merchant %}Update merchant application{% else %}Apply for a merchant account{% endif %}</h2><p>Admin will verify your TIN, contact details and business category before enabling merchant tools.</p>
      <form method="post" action="{{url_for('merchant_apply')}}">{{csrf_field()}}
        <label>Business name<input name="business_name" required maxlength="120" value="{{merchant.business_name|default('')}}"></label>
        <label>TIN<input name="tin" required maxlength="40" value="{{merchant.tin|default('')}}"></label>
        <label>Category<select name="category" required>{% for value in business_categories %}<option value="{{value}}" {% if merchant.category|default('') == value %}selected{% endif %}>{{value}}</option>{% endfor %}</select></label>
        <label>Business phone<input name="business_phone" required value="{{merchant.business_phone|default('')}}"></label>
        <label>Address<input name="address" required maxlength="255" value="{{merchant.address|default('')}}"></label>
        <label>Website (optional)<input type="url" name="website" value="{{merchant.website|default('')}}" placeholder="https://example.com"></label>
        <label>Location or map link (optional)<input name="location" value="{{merchant.location|default('')}}"></label>
        <button class="btn" type="submit">Submit merchant application</button>
      </form>
    </section>
    {% endif %}
  {% else %}
    <section class="merchant-earnings"><article class="card"><span>Total commission</span><strong>{{commission_total|number_format(2)}} ETB</strong></article><article class="card"><span>Pending commission</span><strong>{{commission_pending|number_format(2)}} ETB</strong></article></section>
    <section class="card merchant-form-card"><h2>Create a merchant Ekub</h2><p>People join with your invite code. You approve each join request; the admin keeps control of payment and identity verification.</p><form method="post" action="{{url_for('merchant_create_ekub')}}">{{csrf_field()}}<label>Ekub name<input name="name" required maxlength="80"></label><label>Category<select name="category">{% for value in ekub_categories %}<option>{{value}}</option>{% endfor %}</select></label><label>Contribution frequency<select name="frequency">{% for value in frequencies %}<option>{{value}}</option>{% endfor %}</select></label><label>Contribution per period (ETB)<input type="number" name="base_amount" min="0.01" step="0.01" required></label><label>Number of periods<input type="number" name="duration" min="2" max="500" required></label><button class="btn">Create Ekub</button></form></section>
    <section class="merchant-section"><h2>Your Ekubs</h2>
      {% for ekub in ekubs %}<article class="card merchant-ekub-card"><header><div><span class="merchant-ekub-category">{{ekub.category}} · {{ekub.frequency}}</span><h3>{{ekub.name}}</h3></div><span class="merchant-invite">Invite code <b>{{ekub.invite_code}}</b></span></header><p>{{ekub.base_amount}} ETB per period · {{ekub.duration}} periods · {{ekub.member_rows|length}} members</p>
        {% if ekub.join_requests %}<h4>Waiting for your approval</h4>{% for request in ekub.join_requests %}<div class="merchant-request"><div><b>{{request.first_name}} {{request.last_name}} · @{{request.username}}</b><small>{{request.phone}} · {{request.email|default('No email')}} · KYC {{request.kyc_status}} · {{request.share_type}} share</small></div><div class="merchant-request-actions"><form method="post" action="{{url_for('merchant_request_action', request_id: request.id, action: 'approve')}}">{{csrf_field()}}<button class="btn">Approve</button></form><form method="post" action="{{url_for('merchant_request_action', request_id: request.id, action: 'reject')}}">{{csrf_field()}}<button class="btn ghost">Reject</button></form></div></div>{% endfor %}{% endif %}
        <details class="merchant-members"><summary>Member details ({{ekub.member_rows|length}})</summary><div class="merchant-table-wrap"><table><thead><tr><th>Member</th><th>Phone</th><th>Email</th><th>KYC</th><th>Contribution</th></tr></thead><tbody>{% for member in ekub.member_rows %}<tr><td>{{member.first_name}} {{member.last_name}} · @{{member.username}}</td><td>{{member.phone}}</td><td>{{member.email|default('—')}}</td><td>{{member.kyc_status}}</td><td>{{member.contribution_amount}} ETB</td></tr>{% endfor %}</tbody></table></div></details>
        <details class="merchant-ad-editor"><summary>{% if ekub.ad %}Edit Ekub promotion{% else %}Add promotion{% endif %}</summary><form method="post" enctype="multipart/form-data" action="{{url_for('merchant_save_ad', ekub_id: ekub.id)}}">{{csrf_field()}}<label>Ad title<input name="title" maxlength="120" value="{{ekub.ad.title|default('')}}" required></label><label>Text<textarea name="body" rows="3" maxlength="2000">{{ekub.ad.body|default('')}}</textarea></label><label>Website link<input type="url" name="website_url" value="{{ekub.ad.website_url|default('')}}"></label><label>Business location<input name="location" value="{{ekub.ad.location|default('')}}"></label><label>Images (up to 3, each up to 1 MB)<input type="file" name="images[]" accept="image/jpeg,image/png,image/webp" multiple></label>{% if ekub.ad.images %}<div class="merchant-ad-current">{% for image in ekub.ad.images %}<img src="{{url_for('uploads', name: image)}}" alt="Current promotion image">{% endfor %}</div><small>Select new images to replace the current set.</small>{% endif %}<button class="btn">Save Ekub promotion</button></form></details>
      </article>{% else %}<div class="card merchant-empty"><h3>No Ekubs created yet</h3><p>Create an Ekub above to get an invite code.</p></div>{% endfor %}
    </section>
    <section class="merchant-section"><h2>Commission history</h2><div class="card merchant-table-wrap"><table><thead><tr><th>Ekub</th><th>Pool</th><th>Your 0.5% share</th><th>Platform 1.5%</th><th>Status</th><th>Date</th></tr></thead><tbody>{% for commission in commissions %}<tr><td>{{commission.ekub_name}}</td><td>{{commission.gross_amount}} ETB</td><td>{{commission.amount}} ETB</td><td>{{commission.admin_amount}} ETB</td><td>{{commission.status}}</td><td>{{commission.created_at}}</td></tr>{% else %}<tr><td colspan="6">No commissions yet.</td></tr>{% endfor %}</tbody></table></div></section>
  {% endif %}
</div>
<style>
.merchant-portal{max-width:1160px}.merchant-portal-head{display:flex;justify-content:space-between;align-items:center;gap:15px;margin:25px 0}.merchant-portal-head>div:first-child>span{font-size:.73rem;letter-spacing:.13em;font-weight:900;color:#23a961}.merchant-portal-head h1{margin:.25rem 0}.merchant-portal-head p,.merchant-form-card>p{opacity:.68}.merchant-approved,.merchant-invite{padding:9px 12px;border-radius:30px;background:#e5f6ea;color:#187640;font-weight:800}.merchant-state{padding:17px 20px;margin-bottom:14px}.merchant-state.pending{border-left:5px solid #e5b33b}.merchant-state.rejected{border-left:5px solid #d44855}.merchant-state p{margin:5px 0 0}.merchant-form-card{padding:22px;margin:15px 0 24px}.merchant-form-card h2{margin:0 0 5px}.merchant-form-card form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;margin-top:17px}.merchant-form-card label,.merchant-ad-editor label{display:grid;gap:6px;font-weight:700}.merchant-form-card input,.merchant-form-card select,.merchant-ad-editor input,.merchant-ad-editor textarea{font:inherit;width:100%;padding:11px 12px;border:1px solid rgba(128,128,128,.28);border-radius:12px;background:var(--surface,#fff);color:inherit}.merchant-form-card button{grid-column:1/-1}.merchant-earnings{display:grid;grid-template-columns:repeat(2,1fr);gap:13px}.merchant-earnings article{padding:18px;display:grid;gap:7px}.merchant-earnings span{opacity:.65}.merchant-earnings strong{font-size:1.5rem}.merchant-section{margin:28px 0}.merchant-ekub-card{padding:20px;margin:13px 0}.merchant-ekub-card>header{display:flex;justify-content:space-between;align-items:start;gap:12px}.merchant-ekub-card h3{margin:5px 0}.merchant-ekub-category{font-size:.8rem;opacity:.65}.merchant-invite{display:grid;gap:4px;text-align:center}.merchant-invite b{font-size:1.15rem;letter-spacing:.12em}.merchant-request{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px;border-radius:13px;background:rgba(128,128,128,.07);margin:8px 0}.merchant-request>div:first-child{display:grid;gap:4px}.merchant-request small{opacity:.65}.merchant-request-actions{display:flex;gap:8px}.merchant-request-actions form{margin:0}.merchant-members,.merchant-ad-editor{padding:13px 0;border-top:1px solid rgba(128,128,128,.18);margin-top:13px}.merchant-members summary,.merchant-ad-editor summary{cursor:pointer;font-weight:800}.merchant-table-wrap{overflow:auto}.merchant-table-wrap table{width:100%;border-collapse:collapse;min-width:620px}.merchant-table-wrap th,.merchant-table-wrap td{text-align:left;padding:11px;border-bottom:1px solid rgba(128,128,128,.17)}.merchant-ad-editor form{display:grid;gap:11px;margin-top:13px}.merchant-ad-current{display:flex;gap:8px;flex-wrap:wrap}.merchant-ad-current img{width:110px;height:90px;object-fit:cover;border-radius:10px}.merchant-empty{padding:20px;text-align:center}@media(max-width:650px){.merchant-form-card form{grid-template-columns:1fr}.merchant-form-card button{grid-column:auto}.merchant-request,.merchant-ekub-card>header{align-items:stretch;flex-direction:column}.merchant-request-actions{justify-content:start}.merchant-portal-head{align-items:start;flex-direction:column}}
</style>
{% endblock %}
