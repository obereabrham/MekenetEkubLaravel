{% extends 'base.twig' %}
{% block title %}Merchant account | Mekenet Ekub{% endblock %}
{% block content %}
<main class="merchant-portal">
  <header class="merchant-portal-head"><div><span class="merchant-kicker">Merchant center</span><h1>{% if merchant and merchant.status == 'approved' %}{{merchant.business_name}} dashboard{% else %}Become a Mekenet merchant{% endif %}</h1><p>Merchant Ekubs are private. Members need your invite code and your approval; payments and identity reviews stay with Mekenet Ekub administrators.</p></div><a class="btn ghost" href="{{url_for('profile')}}">My profile</a></header>
  {% if not merchant or merchant.status == 'rejected' %}
    {% if merchant and merchant.status == 'rejected' %}<div class="merchant-review-alert"><strong>Application needs changes</strong><p>{{merchant.rejection_reason}}</p></div>{% endif %}
    <section class="merchant-application card"><h2>Merchant verification</h2><p>Submit your business details and TIN. An administrator will verify the information before enabling merchant tools.</p>
      <form method="post" action="{{url_for('merchant_apply')}}" enctype="multipart/form-data">{{csrf_field()}}
        <div class="merchant-form-grid"><label>Business name<input name="business_name" value="{{merchant.business_name|default('')}}" required maxlength="160"></label><label>TIN (10 digits)<input name="tin" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" value="{{merchant.tin|default('')}}" required></label>
          <label>Business category<select name="category" required><option value="">Choose category</option>{% for value in business_categories %}<option value="{{value}}" {% if merchant.category|default('') == value %}selected{% endif %}>{{value}}</option>{% endfor %}</select></label><label>Contact person<input name="contact_name" value="{{merchant.contact_name|default(user.first_name ~ ' ' ~ user.last_name)}}" required maxlength="160"></label>
          <label>Business phone<input name="business_phone" type="tel" value="{{merchant.business_phone|default(user.phone)}}" required></label><label>Business email<input name="business_email" type="email" value="{{merchant.business_email|default(user.email)}}"></label>
          <label class="wide">Business location and address<input name="address" value="{{merchant.address|default('')}}" required maxlength="255" placeholder="Area, landmark, city (e.g. Bole, Addis Ababa)"><small>This place appears on your Ekub map. We find it from the location name; no coordinates needed.</small></label><label>Website link<input name="website_url" type="url" value="{{merchant.website_url|default('')}}" placeholder="https://example.com"></label><label>TIN document (PDF or image, max 1 MB)<input name="tin_document" type="file" accept=".pdf,image/jpeg,image/png,image/webp"></label>
        </div><p class="merchant-help">Enter the business location as words. No map coordinates are needed.</p><button class="btn btn-primary" type="submit">Submit for admin approval</button>
      </form>
    </section>
  {% elseif merchant.status == 'pending' %}
    <section class="merchant-pending"><div class="merchant-pending-icon">◷</div><h2>Application under review</h2><p>{{merchant.business_name}} · {{merchant.category}} · TIN ending {{merchant.tin|slice(-4)}}</p><p>An administrator will verify your TIN and business information. Merchant tools become available after approval.</p></section>
  {% else %}
    <section class="merchant-stats"><article><span>Commission earned</span><strong>{{earned|number_format(2)}} ETB</strong></article><article><span>Awaiting admin payout</span><strong>{{pending_commission|number_format(2)}} ETB</strong></article><article><span>Your Ekubs</span><strong>{{ekubs|length}}</strong></article></section>
    <section class="merchant-info"><strong>Approved merchant</strong><span>{{merchant.business_name}} · {{merchant.category}} · TIN ending {{merchant.tin|slice(-4)}}</span><small>The 2% service fee is split into 1.5% for Mekenet Ekub and 0.5% merchant commission.</small></section>
    <details class="merchant-create card"><summary><span class="merchant-create-plus">+</span><span><strong>Create a private Ekub</strong><small>Tap to set up an invite-only Ekub in your approved category.</small></span></summary><form method="post" action="{{url_for('merchant_create_ekub')}}" enctype="multipart/form-data">{{csrf_field()}}<div class="merchant-form-grid"><label>Ekub name<input name="name" maxlength="120" required></label><div class="merchant-category-locked"><span>Approved Ekub category</span><strong>{{merchant.category}}</strong><small>Set by admin approval and locked for your Ekubs.</small></div><label>Contribution amount (ETB)<input name="base_amount" type="number" step="0.01" min="0.01" required></label><label>Frequency<select name="frequency">{% for value in frequencies %}<option>{{value}}</option>{% endfor %}</select></label><label>Number of periods<input name="duration" type="number" min="2" max="500" value="12" required></label><label class="wide">Ekub banner image · max 1 MB<input name="banner_image" type="file" accept="image/jpeg,image/png,image/webp"><small>This photo appears at the top of the Ekub cards. You can add or change it later in the advertisement section.</small></label></div><button class="btn btn-primary" type="submit">Create Ekub and generate invite code</button></form></details>
    {% if ekubs %}<h2 class="merchant-section-title">Your private Ekubs</h2><div class="merchant-ekub-list">{% for ekub in ekubs %}
      <article class="merchant-ekub-card" id="merchant-ekub-{{ekub.id}}"><div class="merchant-ekub-cover">{% if ekub.ad.images|default([]) %}<button type="button" class="merchant-image-open" data-lightbox-image="{{ekub.ad.images[0]}}" aria-label="Open {{ekub.category}} Ekub cover photo"><img src="{{ekub.ad.images[0]}}" alt="{{ekub.category}} Ekub cover"></button>{% else %}<div class="merchant-ekub-cover-empty"><span>{{ekub.category|slice(0,1)|upper}}</span></div>{% endif %}<span class="merchant-ekub-category">{{ekub.category}} Ekub</span></div><div class="merchant-ekub-body"><div class="merchant-ekub-head"><div><span class="merchant-kicker">{{ekub.category}} · {{ekub.frequency}}</span><h2>{{ekub.name}}</h2><p>{{ekub.base_amount|number_format(2)}} ETB per period · {{ekub.duration}} periods · {{ekub.status}}</p></div><div class="merchant-code"><small>Invite code</small><strong>{{ekub.join_code}}</strong><button type="button" class="merchant-copy-code" data-copy-invite="{{ekub.join_code}}">▢ Copy code</button><small class="merchant-copy-status" aria-live="polite"></small></div></div>
        <div class="merchant-capacity">{{ekub.members|length}} members · {{ekub.requests|length}} pending requests · Share this code only with invited members</div>
        {% if ekub.requests %}<section class="merchant-subsection"><h3>Join requests</h3>{% for request in ekub.requests %}<div class="merchant-request-row"><span><b>{{request.first_name}} {{request.last_name}}</b> · @{{request.username}} · {{request.phone}} · {{request.share_type}} share</span><div><form method="post" action="{{url_for('merchant_join_decision', request_id: request.id, action: 'approve')}}">{{csrf_field()}}<button class="btn" type="submit">Approve</button></form><form method="post" action="{{url_for('merchant_join_decision', request_id: request.id, action: 'reject')}}">{{csrf_field()}}<button class="btn ghost" type="submit">Reject</button></form></div></div>{% endfor %}</section>{% endif %}
        <details class="merchant-subsection"><summary>Member information ({{ekub.members|length}})</summary><div class="merchant-member-list">{% for member in ekub.members %}<div class="merchant-member-row"><span class="merchant-member-avatar">{% if member.profile_picture %}<img src="{{url_for('uploads', name: member.profile_picture)}}" alt="{{member.first_name}} profile picture">{% else %}{{member.first_name|default('M')|slice(0,1)|upper}}{% endif %}</span><span class="merchant-member-name"><b>{{member.first_name}} {{member.last_name}}</b><small>@{{member.username}} · {{member.phone}}</small></span><span>{{member.contribution_amount|number_format(2)}} ETB · {{member.share_type}}</span></div>{% else %}<p>No approved members yet.</p>{% endfor %}</div></details>
        <details class="merchant-subsection"><summary>Ekub advertisement</summary><form method="post" action="{{url_for('merchant_save_ad', ekub_id: ekub.id)}}" enctype="multipart/form-data">{{csrf_field()}}<div class="merchant-form-grid"><label>Ad title<input name="title" maxlength="160" value="{{ekub.ad.title|default(merchant.business_name)}}" required></label><label>Website link<input name="website_url" type="url" value="{{ekub.ad.website_url|default(merchant.website_url)}}" placeholder="https://example.com"></label><label class="wide">Product or service description<textarea name="description" rows="4" maxlength="3000">{{ekub.ad.description|default('')}}</textarea></label><label class="wide">Location on this Ekub<input name="location_name" maxlength="255" value="{{ekub.ad.location_name|default(merchant.address)}}" placeholder="Area, landmark, city"><small>Leave the business address or enter a place name. It will be shown on the map in this Ekub.</small></label><label>Up to 3 images, max 1 MB each<input name="images[]" type="file" accept="image/jpeg,image/png,image/webp" multiple></label></div>
          {% if ekub.ad.images|default([]) %}<div class="merchant-current-images">{% for image in ekub.ad.images %}<button type="button" class="merchant-image-open" data-lightbox-image="{{image}}" aria-label="Open merchant image"><img src="{{image}}" alt="Current merchant ad image"></button>{% endfor %}</div>{% endif %}<small>Upload up to 3 images, max 1 MB each. Click any image to view it and zoom. A map card appears on the Ekub details page and opens this exact location.</small><button class="btn" type="submit">Save advertisement</button></form></details>
      </div></article>{% endfor %}</div>{% endif %}
    <section class="merchant-commission-list"><h2>Commission ledger</h2><p>Commission is earned when admin selects a winner after all period payments are verified. Admin controls transfer approval.</p>{% if commissions %}<div class="merchant-table-wrap"><table><thead><tr><th>Ekub</th><th>Period</th><th>Approved pool</th><th>0.5% commission</th><th>Status</th><th>Date</th></tr></thead><tbody>{% for row in commissions %}<tr><td>{{row.ekub_name}}</td><td>{{row.period_no}}</td><td>{{row.gross_amount|number_format(2)}} ETB</td><td>{{row.commission_amount|number_format(2)}} ETB</td><td>{{row.status}}</td><td>{{row.created_at|date('d M Y')}}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p>No commissions yet.</p>{% endif %}</section>
  {% endif %}
</main>
<dialog class="merchant-lightbox" id="merchant-image-viewer" aria-label="Image viewer">
  <div class="merchant-lightbox-toolbar">
    <span>Photo preview · use zoom controls or pinch</span>
    <div><button type="button" id="merchant-image-zoom-out" aria-label="Zoom out">−</button><button type="button" id="merchant-image-zoom-in" aria-label="Zoom in">+</button><button type="button" id="merchant-image-close" aria-label="Close image">×</button></div>
  </div>
  <div class="merchant-lightbox-stage"><img id="merchant-lightbox-photo" alt="Ekub photo preview"></div>
</dialog>
<style>.merchant-portal{width:min(1250px,calc(100% - 36px));margin:38px auto 72px;color:var(--text)}.merchant-portal-head{display:flex;justify-content:space-between;align-items:end;gap:18px;margin-bottom:24px}.merchant-portal-head h1{font-size:clamp(2rem,4vw,3rem);margin:7px 0}.merchant-portal-head p,.merchant-application>p,.merchant-create>p,.merchant-section-title+p{color:var(--muted);max-width:850px}.merchant-kicker{color:#4ed58c;font-size:.76rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.merchant-application,.merchant-create,.merchant-ekub-card,.merchant-commission-list,.merchant-pending,.merchant-info{padding:clamp(18px,3vw,28px);border:1px solid var(--border);border-radius:22px;background:var(--panel,rgba(255,255,255,.04));margin-bottom:20px}.merchant-application h2,.merchant-create h2{margin:0 0 8px}.merchant-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:18px 0}.merchant-form-grid label{display:grid;gap:7px;font-weight:750}.merchant-form-grid label.wide{grid-column:1/-1}.merchant-form-grid input,.merchant-form-grid select,.merchant-form-grid textarea{box-sizing:border-box;width:100%;min-height:46px;padding:11px 13px;border:1px solid var(--border);border-radius:12px;background:var(--input,rgba(255,255,255,.04));color:var(--text)}.merchant-form-grid input[type=file]{padding:8px}.merchant-category-locked{display:grid;gap:5px;align-content:center;min-height:46px;padding:11px 13px;border:1px solid var(--border);border-radius:12px;background:rgba(72,177,116,.08)}.merchant-category-locked span,.merchant-category-locked small{color:var(--muted);font-size:.78rem}.merchant-category-locked strong{color:var(--text)}.merchant-help,.merchant-application small{color:var(--muted)}.merchant-pending{text-align:center;padding:58px 20px}.merchant-pending-icon{margin:auto;width:65px;height:65px;border-radius:20px;display:grid;place-items:center;background:rgba(80,181,218,.14);font-size:2rem;color:#52bad5}.merchant-review-alert{padding:17px;border-radius:16px;background:rgba(220,65,65,.12);margin-bottom:18px}.merchant-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:18px}.merchant-stats article{display:grid;gap:8px;padding:20px;border-radius:19px;border:1px solid var(--border);background:var(--panel,rgba(255,255,255,.04));color:var(--muted)}.merchant-stats strong{font-size:1.65rem;color:var(--text)}.merchant-info{display:grid;gap:6px}.merchant-info small{color:var(--muted)}.merchant-section-title{margin:30px 0 14px}.merchant-ekub-list{display:grid;gap:16px}.merchant-ekub-head{display:flex;justify-content:space-between;gap:14px}.merchant-ekub-head h2{margin:6px 0}.merchant-ekub-head p,.merchant-capacity,.merchant-subsection small{color:var(--muted)}.merchant-code{display:grid;align-content:center;text-align:center;min-width:150px;padding:10px 15px;border-radius:16px;background:rgba(89,190,129,.14)}.merchant-code small{color:var(--muted)}.merchant-code strong{font-size:1.55rem;letter-spacing:.12em}.merchant-copy-code{justify-self:center;margin-top:8px;padding:7px 11px;border:1px solid var(--border);border-radius:9px;background:var(--surface,rgba(255,255,255,.12));color:var(--text);font:inherit;font-size:.8rem;font-weight:800;cursor:pointer}.merchant-copy-status{min-height:1em}.merchant-capacity{padding:12px;border-radius:12px;background:rgba(255,255,255,.035)}.merchant-subsection{margin-top:15px;padding:15px;border:1px solid var(--border);border-radius:15px}.merchant-subsection summary{font-weight:850;cursor:pointer}.merchant-request-row{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:13px 0;border-bottom:1px solid var(--border)}.merchant-request-row>div{display:flex;gap:8px}.merchant-request-row form{display:inline}.merchant-member-list>div{display:grid;grid-template-columns:36px minmax(130px,1.4fr) minmax(100px,1fr);align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--border)}.merchant-member-list span{color:var(--muted)}.merchant-member-name{display:grid;gap:3px}.merchant-member-name b{color:var(--text)}.merchant-member-name small{color:var(--muted);font-size:.82rem}.merchant-member-avatar{width:36px;height:36px;display:grid;place-items:center;overflow:hidden;border-radius:50%;background:linear-gradient(135deg,var(--green),var(--blue));color:white;font-weight:900}.merchant-member-avatar img{width:100%;height:100%;object-fit:cover}.merchant-subsection form{margin-top:14px}.merchant-subsection form>small{display:block;margin:12px 0;color:var(--muted)}.merchant-current-images{display:flex;gap:10px;margin:12px 0}.merchant-current-images img{width:110px;height:85px;object-fit:cover;border-radius:12px}.merchant-commission-list{margin-top:25px}.merchant-commission-list>p{color:var(--muted)}.merchant-table-wrap{overflow-x:auto}.merchant-table-wrap table{width:100%;border-collapse:collapse}.merchant-table-wrap th,.merchant-table-wrap td{text-align:left;padding:12px;border-bottom:1px solid var(--border);white-space:nowrap}.merchant-table-wrap th{color:var(--muted)}@media(max-width:700px){.merchant-portal{width:calc(100% - 26px);margin:24px auto}.merchant-portal-head{align-items:flex-start;flex-direction:column}.merchant-stats{grid-template-columns:1fr}.merchant-form-grid{grid-template-columns:1fr}.merchant-form-grid label.wide{grid-column:auto}.merchant-ekub-head{flex-direction:column}.merchant-code{justify-items:start;text-align:left}.merchant-copy-code{justify-self:start}.merchant-request-row{align-items:flex-start;flex-direction:column}.merchant-member-list>div{grid-template-columns:36px minmax(0,1fr)}.merchant-member-list>div>span:last-child{grid-column:2}}</style>
<style>
.merchant-create{padding:0;overflow:hidden}.merchant-create>summary{display:flex;align-items:center;gap:14px;padding:18px 22px;cursor:pointer;list-style:none}.merchant-create>summary::-webkit-details-marker{display:none}.merchant-create>summary>span:last-child{display:grid;gap:3px}.merchant-create>summary strong{font-size:1.1rem}.merchant-create>summary small{color:var(--muted)}.merchant-create-plus{width:46px;height:46px;display:grid;place-items:center;border-radius:50%;background:linear-gradient(135deg,#82b648,#35a6b3);color:white;font-size:2rem;font-weight:500;box-shadow:0 7px 18px rgba(53,166,114,.25)}.merchant-create[open]>summary{border-bottom:1px solid var(--border)}.merchant-create>form{padding:0 clamp(18px,3vw,28px) 24px}.merchant-ekub-card{padding:0;overflow:hidden;box-shadow:0 14px 34px rgba(0,0,0,.10)}.merchant-ekub-cover{height:220px;position:relative;overflow:hidden;background:linear-gradient(135deg,#2e9868,#49b3c2)}.merchant-ekub-cover>button{position:absolute;inset:0;width:100%;height:100%;padding:0;border:0;background:transparent;cursor:zoom-in}.merchant-ekub-cover>button img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}.merchant-ekub-cover>button:hover img{transform:scale(1.04)}.merchant-ekub-cover:after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(0,0,0,.03),rgba(0,0,0,.48))}.merchant-ekub-cover-empty{height:100%;display:grid;place-items:center;background:radial-gradient(circle at 20% 20%,rgba(255,255,255,.22),transparent 33%),linear-gradient(130deg,#278862,#43afbd)}.merchant-ekub-cover-empty span{display:grid;place-items:center;width:92px;height:92px;border:2px solid rgba(255,255,255,.55);border-radius:27px;background:rgba(255,255,255,.16);color:#fff;font-size:3.3rem;font-weight:900}.merchant-ekub-category{position:absolute;z-index:1;left:18px;bottom:16px;padding:8px 13px;border:1px solid rgba(255,255,255,.45);border-radius:30px;background:rgba(8,31,27,.66);color:#fff;font-weight:850;backdrop-filter:blur(8px)}.merchant-ekub-body{padding:clamp(16px,2.4vw,26px)}.merchant-current-images{display:flex;gap:10px;margin:12px 0;overflow-x:auto;padding:2px}.merchant-current-images button{flex:0 0 auto;width:118px;height:88px;padding:0;border:0;border-radius:13px;overflow:hidden;background:transparent;cursor:zoom-in}.merchant-current-images img{width:100%;height:100%;object-fit:cover;transition:transform .25s ease}.merchant-current-images button:hover img{transform:scale(1.07)}.merchant-lightbox{width:min(1000px,96vw);height:min(92vh,900px);padding:0;border:1px solid rgba(255,255,255,.18);border-radius:18px;background:#081311;color:#fff;overflow:hidden}.merchant-lightbox::backdrop{background:rgba(0,0,0,.86);backdrop-filter:blur(5px)}.merchant-lightbox-toolbar{height:58px;display:flex;align-items:center;justify-content:space-between;padding:0 14px;color:rgba(255,255,255,.75);font-size:.9rem}.merchant-lightbox-toolbar>div{display:flex;gap:8px}.merchant-lightbox-toolbar button{width:38px;height:38px;border:1px solid rgba(255,255,255,.2);border-radius:12px;background:rgba(255,255,255,.1);color:white;font-size:1.3rem;cursor:pointer}.merchant-lightbox-stage{height:calc(100% - 58px);display:grid;place-items:center;overflow:auto;padding:12px;touch-action:pan-x pan-y pinch-zoom}.merchant-lightbox-stage img{max-width:100%;max-height:100%;object-fit:contain;transform-origin:center;transition:transform .16s ease;cursor:zoom-in}.merchant-lightbox-stage img.is-zoomed{cursor:zoom-out}
</style>
<style>.merchant-ekub-category{pointer-events:none}</style>
<script>
var merchantViewer=document.getElementById('merchant-image-viewer');var merchantViewerImage=document.getElementById('merchant-lightbox-photo');var merchantZoom=1;
document.querySelectorAll('.merchant-image-open').forEach(function(button){button.addEventListener('click',function(){merchantViewerImage.src=button.getAttribute('data-lightbox-image')||'';merchantZoom=1;merchantViewerImage.style.transform='scale(1)';merchantViewerImage.classList.remove('is-zoomed');merchantViewer.showModal();});});
function setMerchantZoom(delta){merchantZoom=Math.max(1,Math.min(4,merchantZoom+delta));merchantViewerImage.style.transform='scale('+merchantZoom+')';merchantViewerImage.classList.toggle('is-zoomed',merchantZoom>1);}
document.getElementById('merchant-image-zoom-in').addEventListener('click',function(){setMerchantZoom(.35);});document.getElementById('merchant-image-zoom-out').addEventListener('click',function(){setMerchantZoom(-.35);});document.getElementById('merchant-image-close').addEventListener('click',function(){merchantViewer.close();});
merchantViewerImage.addEventListener('dblclick',function(){merchantZoom=merchantZoom>1?1:2;merchantViewerImage.style.transform='scale('+merchantZoom+')';merchantViewerImage.classList.toggle('is-zoomed',merchantZoom>1);});
merchantViewer.addEventListener('click',function(event){if(event.target===merchantViewer)merchantViewer.close();});
document.querySelectorAll('.merchant-copy-code').forEach(function(button){button.addEventListener('click',async function(){var code=button.getAttribute('data-copy-invite')||'';var status=button.parentElement.querySelector('.merchant-copy-status');try{if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(code);}else{var input=document.createElement('textarea');input.value=code;input.style.position='fixed';input.style.opacity='0';document.body.appendChild(input);input.select();document.execCommand('copy');input.remove();}if(status)status.textContent='Copied';}catch(e){if(status)status.textContent='Select the code to copy';}})});
document.querySelectorAll('.merchant-subsection input[type="file"][multiple]').forEach(function(input){input.addEventListener('change',function(){var files=Array.from(input.files||[]);if(files.length>3||files.some(function(file){return file.size>1048576})){alert('Choose up to 3 images, each 1 MB or smaller.');input.value='';}})});document.querySelectorAll('.merchant-application input[type="file"],.merchant-create input[type="file"]').forEach(function(input){input.addEventListener('change',function(){if(input.files[0]&&input.files[0].size>1048576){alert(input.name==='banner_image'?'Banner image must be 1 MB or smaller.':'TIN document must be 1 MB or smaller.');input.value='';}})});
</script>
{% endblock %}
