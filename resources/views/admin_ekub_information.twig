{% extends 'base.twig' %}
{% block title %}{{ekub.name}} · Member Information{% endblock %}
{% block content %}
<div class="container admin-member-page">
  <div class="page-top">
    <div>
      <span class="eyebrow">EKUB MEMBER INFORMATION</span>
      <h1>{{ekub.name}}</h1>
      <p class="muted">All members currently joined to this Ekub.</p>
    </div>
    <div class="top-actions">
      <a class="btn ghost" href="{{url_for('admin_dashboard')}}">← Admin Dashboard</a>
      {% if ekub.status == 'started' %}<a class="btn" href="{{url_for('pick_winner', ekub_id: ekub.id, period_no: ekub.current_period)}}">Pick Winner</a>{% endif %}
      <a class="btn" href="{{url_for('ekub_detail', ekub_id: ekub.id)}}">View Details</a>
    </div>
  </div>

  <div class="summary-grid">
    <div class="summary-card"><span>Category</span><strong>{{ekub.category}}</strong></div>
    <div class="summary-card"><span>Frequency</span><strong>{{ekub.frequency}}</strong></div>
    <div class="summary-card"><span>Contribution</span><strong>{{ekub.base_amount}} ETB</strong></div>
    <div class="summary-card"><span>Joined Members</span><strong>{{members|length}}</strong></div>
  </div>

  <section class="members-panel">
    <div class="panel-head">
      <div><h2>All Joined Members</h2><p class="muted">Member information and share details for {{ekub.name}}.</p></div>
      <span class="count-badge">{{members|length}} member{% if members|length != 1 %}s{% endif %}</span>
    </div>

    {% if members %}
    <div class="table-wrap">
      <table class="member-table">
        <thead><tr><th>#</th><th>Member</th><th>Username</th><th>Phone</th><th>Email</th><th>Default payment method</th><th>Share</th><th>Contribution</th><th>Status</th></tr></thead>
        <tbody>
        {% for m in members %}
          <tr>
            <td>{{loop.index}}</td>
            <td><div class="member-name"><span class="avatar">{{(m.first_name ? m.first_name|slice(0, 1) : 'U')|upper}}</span><div><strong>{{m.first_name}} {{m.last_name}}</strong><small>Member ID #{{m.user_id}}</small></div></div></td>
            <td>@{{m.username}}</td>
            <td>{{m.phone}}</td>
            <td>{{m.email|default('—')}}</td>
            <td>{% if m.pm_bank %}<strong>{{m.pm_bank}}</strong><br>{{m.pm_number}}<br><small>{{m.pm_name}}</small>{% else %}<span class="muted">Not set</span>{% endif %}</td>
            <td><span class="chip">{{m.share_type}}</span></td>
            <td><strong>{{m.contribution_amount}} ETB</strong></td>
            <td><span class="status">{{m.status|capitalize}}</span></td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <div class="empty"><div class="empty-icon">◎</div><h3>No joined members yet</h3><p>This Ekub does not have any members yet.</p></div>
    {% endif %}
  </section>

  <section class="members-panel" style="margin-top:20px">
    <div class="panel-head">
      <div><h2>Winners by period</h2><p class="muted">Winner of each period with the payout account to send the money to.</p></div>
      <span class="count-badge">{{winners|length}} of {{ekub.duration}} drawn</span>
    </div>
    {% if winners %}
    <div class="table-wrap">
      <table class="member-table">
        <thead><tr><th>Period</th><th>Winner</th><th>Phone</th><th>Payout account</th><th>Gross</th><th>Service fee</th><th>Net payout</th><th>Date</th></tr></thead>
        <tbody>
        {% for w in winners %}
          <tr>
            <td><span class="chip">Period {{w.period_no}}</span></td>
            <td><strong>{{w.first_name}} {{w.last_name}}</strong><br><small>@{{w.username}}</small></td>
            <td>{{w.phone}}</td>
            <td>{% if w.pm_bank %}<strong>{{w.pm_bank}}</strong><br>{{w.pm_number}}<br><small>{{w.pm_name}}</small>{% else %}<span class="muted">Not set</span>{% endif %}</td>
            <td>{{format_amount(w.gross_amount)}} ETB</td>
            <td>{{format_amount(w.service_fee)}} ETB</td>
            <td><strong>{{format_amount(w.net_amount)}} ETB</strong></td>
            <td>{{w.created_at}}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <div class="empty"><div class="empty-icon">&#127942;</div><h3>No winners yet</h3><p>Winners appear here after each period's draw.</p></div>
    {% endif %}
  </section>
</div>
<style>
.admin-member-page{padding-bottom:40px}.page-top{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin:12px 0 24px}.page-top h1{margin:4px 0 5px}.eyebrow{font-size:.72rem;font-weight:800;letter-spacing:.12em;opacity:.62}.muted{opacity:.68;margin:.2rem 0}.top-actions{display:flex;gap:8px;flex-wrap:wrap}.summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}.summary-card{padding:17px;border:1px solid rgba(127,127,127,.15);border-radius:18px;background:var(--card-bg,#fff);box-shadow:0 8px 22px rgba(0,0,0,.05)}.summary-card span{display:block;font-size:.76rem;opacity:.6;margin-bottom:6px}.summary-card strong{font-size:1rem}.members-panel{border:1px solid rgba(127,127,127,.15);border-radius:20px;background:var(--card-bg,#fff);box-shadow:0 10px 28px rgba(0,0,0,.05);overflow:hidden}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:20px;border-bottom:1px solid rgba(127,127,127,.12)}.panel-head h2{margin:0 0 4px}.count-badge,.chip,.status{display:inline-flex;align-items:center;border-radius:999px;padding:6px 10px;font-size:.74rem;font-weight:800}.count-badge{background:rgba(37,99,235,.1);color:var(--primary,#2563eb)}.chip{background:rgba(127,127,127,.1)}.status{background:rgba(34,197,94,.11);color:#16803c}.table-wrap{overflow-x:auto}.member-table{width:100%;border-collapse:collapse;min-width:980px}.member-table th,.member-table td{padding:13px 15px;text-align:left;border-bottom:1px solid rgba(127,127,127,.1);font-size:.86rem}.member-table th{font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;opacity:.58;background:rgba(127,127,127,.035)}.member-table tr:last-child td{border-bottom:0}.member-name{display:flex;align-items:center;gap:10px}.member-name small{display:block;opacity:.55;margin-top:2px}.avatar{width:36px;height:36px;flex:0 0 36px;border-radius:12px;display:grid;place-items:center;background:var(--primary,#2563eb);color:#fff;font-weight:900}.empty{text-align:center;padding:50px 20px}.empty-icon{font-size:2rem;opacity:.45;margin-bottom:8px}.empty h3{margin:0 0 5px}@media(max-width:900px){.summary-grid{grid-template-columns:repeat(2,1fr)}.page-top{align-items:flex-start;flex-direction:column}}@media(max-width:520px){.summary-grid{grid-template-columns:1fr}.top-actions{width:100%}.top-actions .btn{flex:1;text-align:center}}
</style>
{% endblock %}
