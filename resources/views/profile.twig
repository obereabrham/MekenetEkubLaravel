{% extends 'base.twig' %}
{% block content %}
<div class="card form-card profile-page">
  <h1>My Profile</h1>
  <p>KYC: <span class="pill">{{user.kyc_status}}</span></p>
  {% if user.kyc_status == 'approved' %}<p style="color:var(--muted)">Your information is locked after KYC approval. You can only change your profile picture.</p>{% endif %}
  <div class="profile-fields">
  {% for field,label in {'first_name':'First name','last_name':'Last name','username':'Username','phone':'Phone number','email':'Email address'} %}
    <section class="profile-field">
      <div class="profile-field-value"><span class="profile-label">{{label}}</span><strong>{{user[field]|default('Not set')}}</strong></div>
      {% if user.kyc_status == 'approved' %}<span class="pill" title="Locked after KYC approval">🔒 Locked</span>
      {% elseif edit_field == field %}
        <form class="profile-edit-form" method="post" action="{{url_for('profile_edit', field: field)}}">{{ csrf_field() }}
          <input name="value" value="{{user[field]|default('')}}" required {% if field=='email' %}type="email"{% elseif field=='phone' %}type="tel"{% else %}type="text"{% endif %}>
          <button class="btn" type="submit">Continue</button><a class="btn ghost" href="{{url_for('profile')}}">Cancel</a>
          
        </form>
      {% else %}<a class="btn ghost profile-edit-button" href="{{url_for('profile', edit: field)}}">Edit</a>{% endif %}
    </section>
  {% endfor %}
  <section class="profile-field profile-picture-field">
    <div class="profile-field-value"><span class="profile-label">Profile picture</span>{% if user.profile_picture %}<img class="profile-edit-avatar" src="{{url_for('static', filename: 'uploads/' ~ user.profile_picture)}}" alt="Profile picture">{% else %}<strong>Not set</strong>{% endif %}</div>
    <form method="post" action="{{url_for('profile_picture_update')}}" enctype="multipart/form-data">{{ csrf_field() }}<input type="file" name="profile_picture" accept="image/*" required><button class="btn" type="submit">Update picture</button></form>
  </section>
  </div>
  <br><a class="btn ghost" href="{{url_for('kyc')}}">KYC Verification</a> <a class="btn ghost" href="{{url_for('security_2fa')}}">Two-factor security</a>
  <p><a class="btn" href="{{url_for('merchant_portal')}}">{% if user.role == 'merchant' %}Merchant dashboard{% else %}Merchant account{% endif %}</a></p>
  <section id="website-rating" class="card website-rating-card">
    <h2>Rate and review the website</h2>
    <p>Tell us how your experience with Mekenet Ekub has been.</p>
    <form method="post" action="{{url_for('rate_website')}}">{{csrf_field()}}
      <label for="website-rating-score">Your rating</label>
      <select id="website-rating-score" name="rating" required>
        {% for value in [5,4,3,2,1] %}<option value="{{value}}" {% if site_rating == value %}selected{% endif %}>{{value}} star{% if value != 1 %}s{% endif %}</option>{% endfor %}
      </select>
      <label for="website-rating-comment">Comment (optional)</label>
      <textarea id="website-rating-comment" name="comment" maxlength="1000" rows="3" placeholder="What worked well? What could be better?">{{site_comment|default('')}}</textarea>
      <button class="btn" type="submit">Submit rating</button>
      {% if site_rating %}<small>Thank you. Your latest rating is {{site_rating}}/5.</small>{% endif %}
    </form>
  </section>
</div>
<style>.website-rating-card{margin-top:24px;padding:22px}.website-rating-card h2{margin:0 0 5px}.website-rating-card p{opacity:.7}.website-rating-card form{display:grid;gap:9px;max-width:540px}.website-rating-card textarea{font:inherit;padding:12px;border:1px solid var(--border,#d5ded8);border-radius:12px;background:var(--surface,#fff);color:inherit}.website-rating-card select{max-width:220px}</style>
{% endblock %}
