{
  "name": "mekenet/ekub",
  "type": "project",
  "description": "Mekenet Ekub community savings platform, ported to Laravel and MySQL.",
  "keywords": ["laravel", "ekub", "community-savings"],
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "phpseclib/phpseclib": "~3.0.36",
    "pragmarx/google2fa": "^8.0",
    "twig/twig": "^3.0"
  },
  "autoload": {
    "psr-4": { "App\\": "app/", "Database\\Seeders\\": "database/seeders/" },
    "files": ["app/helpers.php"]
  },
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "post-create-project-cmd": ["@php artisan key:generate --ansi", "@php artisan migrate --force"]
  },
  "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true },
  "minimum-stability": "stable",
  "prefer-stable": true
}
